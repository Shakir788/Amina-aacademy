<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AMINA Académie | Comptabilité · Anglais · Marketing Digital</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #4338CA;
            --primary-light: #6366F1;
            --accent: #F59E0B;
            --teal: #0F766E;
            --purple: #7C3AED;
            --bg: #F8FAFC;
            --dark: #0F172A;
            --muted: #64748B;
            --border: #E2E8F0;
            --white: #FFFFFF;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--dark);
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ─── NAVBAR ─── */
        nav {
            padding: 16px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(0,0,0,0.06);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 22px;
            font-weight: 900;
            color: var(--dark);
            text-decoration: none;
            letter-spacing: -0.5px;
        }
        .logo span { color: var(--primary); }

        .nav-links { display: flex; align-items: center; gap: 8px; }
        .nav-links a {
            color: var(--muted);
            text-decoration: none;
            font-weight: 500;
            font-size: 15px;
            padding: 8px 16px;
            border-radius: 8px;
            transition: 0.2s;
        }
        .nav-links a:hover { color: var(--dark); background: var(--bg); }

        .btn-nav-login {
            color: var(--dark) !important;
            font-weight: 600 !important;
        }
        .btn-nav-cta {
            background: var(--dark) !important;
            color: #fff !important;
            padding: 10px 22px !important;
            border-radius: 50px !important;
            font-weight: 700 !important;
            font-size: 14px !important;
        }
        .btn-nav-cta:hover { background: var(--primary) !important; }

        .menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 26px;
            cursor: pointer;
            color: var(--dark);
        }

        /* Mobile sidebar */
        .mob-sidebar {
            position: fixed;
            top: 0; right: -100%;
            width: 290px;
            height: 100vh;
            background: var(--white);
            z-index: 2000;
            padding: 40px 28px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: -20px 0 60px rgba(0,0,0,0.08);
        }
        .mob-sidebar.open { right: 0; }
        .mob-close { align-self: flex-end; font-size: 28px; cursor: pointer; color: var(--muted); margin-bottom: 24px; }
        .mob-sidebar a {
            text-decoration: none;
            color: var(--dark);
            font-size: 17px;
            font-weight: 600;
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
        }
        .mob-cta {
            background: var(--primary) !important;
            color: white !important;
            text-align: center;
            border-radius: 12px !important;
            padding: 16px !important;
            margin-top: 20px;
            border: none !important;
        }
        .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 1500; display: none; }
        .overlay.open { display: block; }

        /* ─── HERO ─── */
        .hero {
            padding: 100px 7% 80px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            background:
                radial-gradient(ellipse at 0% 0%, rgba(99,102,241,0.08) 0%, transparent 55%),
                radial-gradient(ellipse at 100% 100%, rgba(245,158,11,0.07) 0%, transparent 55%);
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #EEF2FF;
            color: var(--primary);
            font-size: 13px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 50px;
            margin-bottom: 24px;
            letter-spacing: 0.3px;
        }
        .eyebrow::before { content: ''; width: 6px; height: 6px; background: var(--primary); border-radius: 50%; }

        .hero h1 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 58px;
            font-weight: 900;
            line-height: 1.08;
            letter-spacing: -2.5px;
            margin-bottom: 22px;
        }
        .hero h1 em {
            font-style: normal;
            background: linear-gradient(135deg, var(--primary) 0%, #818CF8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 18px;
            color: var(--muted);
            max-width: 480px;
            margin-bottom: 38px;
            line-height: 1.7;
        }

        .hero-btns { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
        .btn-main {
            background: var(--primary);
            color: white;
            padding: 15px 32px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            box-shadow: 0 8px 30px rgba(67,56,202,0.28);
            transition: 0.25s;
        }
        .btn-main:hover { background: var(--dark); transform: translateY(-2px); }
        .btn-ghost {
            color: var(--dark);
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-ghost:hover { color: var(--primary); }

        .hero-stats {
            display: flex;
            gap: 32px;
            margin-top: 44px;
            padding-top: 32px;
            border-top: 1px solid var(--border);
        }
        .stat-item { display: flex; flex-direction: column; gap: 2px; }
        .stat-num {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 26px;
            font-weight: 900;
            color: var(--dark);
            letter-spacing: -1px;
        }
        .stat-label { font-size: 13px; color: var(--muted); font-weight: 500; }

        /* Hero visual side */
        .hero-visual { position: relative; }
        .hero-card-stack { position: relative; }

        .dashboard-mock {
            background: white;
            border-radius: 20px;
            border: 1px solid var(--border);
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0,0,0,0.1);
        }
        .mock-topbar {
            background: var(--dark);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .mock-dot { width: 10px; height: 10px; border-radius: 50%; }
        .mock-title {
            color: rgba(255,255,255,0.6);
            font-size: 13px;
            margin-left: 10px;
            font-weight: 500;
        }

        .mock-body { padding: 20px; }
        .mock-greeting { font-weight: 700; font-size: 16px; margin-bottom: 16px; }

        .mock-courses { display: flex; flex-direction: column; gap: 10px; }
        .mock-course-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            background: var(--bg);
            border-radius: 10px;
            border: 1px solid var(--border);
        }
        .mock-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
        .mock-info { flex: 1; }
        .mock-course-name { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
        .mock-prog-bar { height: 4px; background: var(--border); border-radius: 4px; }
        .mock-prog-fill { height: 4px; border-radius: 4px; }

        /* floating badges */
        .float-badge-1 {
            position: absolute;
            top: -18px;
            right: -20px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            font-size: 14px;
            font-weight: 700;
        }
        .float-badge-2 {
            position: absolute;
            bottom: -18px;
            left: -24px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            font-size: 14px;
            font-weight: 700;
        }

        /* ─── COURSES SECTION ─── */
        .courses-section {
            padding: 90px 7%;
            background: white;
        }

        .section-header { text-align: center; margin-bottom: 60px; }
        .section-eyebrow {
            display: inline-block;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--primary);
            margin-bottom: 14px;
        }
        .section-header h2 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 42px;
            font-weight: 900;
            letter-spacing: -1.5px;
            margin-bottom: 14px;
        }
        .section-header p {
            font-size: 17px;
            color: var(--muted);
            max-width: 520px;
            margin: 0 auto;
        }

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .course-card {
            border-radius: 20px;
            border: 1px solid var(--border);
            overflow: hidden;
            background: var(--bg);
            transition: 0.3s;
            display: flex;
            flex-direction: column;
        }
        .course-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.08); border-color: transparent; }

        .course-banner {
            height: 170px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 52px;
            position: relative;
        }

        .course-tag {
            position: absolute;
            top: 16px;
            right: 16px;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 50px;
            letter-spacing: 0.3px;
        }

        .course-body { padding: 26px; flex: 1; display: flex; flex-direction: column; }
        .course-body h3 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 10px;
            letter-spacing: -0.4px;
        }
        .course-body p { font-size: 15px; color: var(--muted); line-height: 1.6; flex: 1; }

        .course-modules {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin: 18px 0;
        }
        .module-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            font-weight: 500;
        }
        .module-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

        .btn-course {
            display: block;
            text-align: center;
            padding: 13px;
            border-radius: 10px;
            font-weight: 700;
            text-decoration: none;
            font-size: 15px;
            margin-top: auto;
            transition: 0.2s;
        }

        /* ─── HOW IT WORKS ─── */
        .how-section {
            padding: 90px 7%;
            background: var(--bg);
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-top: 56px;
            position: relative;
        }
        .steps-grid::before {
            content: '';
            position: absolute;
            top: 28px;
            left: 12%;
            right: 12%;
            height: 2px;
            background: linear-gradient(to right, var(--primary), var(--purple));
            opacity: 0.2;
        }

        .step-card {
            background: white;
            border-radius: 16px;
            padding: 28px 22px;
            border: 1px solid var(--border);
            text-align: center;
            position: relative;
            transition: 0.3s;
        }
        .step-card:hover { transform: translateY(-4px); border-color: var(--primary); }

        .step-num {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: var(--primary);
            color: white;
            font-weight: 900;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .step-card h3 { font-weight: 700; font-size: 16px; margin-bottom: 10px; }
        .step-card p { font-size: 14px; color: var(--muted); line-height: 1.6; }

        /* ─── PRICING ─── */
        .pricing-section {
            padding: 90px 7%;
            background: white;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            max-width: 820px;
            margin: 56px auto 0;
        }

        .pricing-card {
            border-radius: 20px;
            border: 1px solid var(--border);
            padding: 36px 32px;
            background: var(--bg);
            position: relative;
            transition: 0.3s;
        }
        .pricing-card:hover { transform: translateY(-4px); }
        .pricing-card.featured {
            background: var(--dark);
            color: white;
            border: none;
            box-shadow: 0 20px 60px rgba(15,23,42,0.2);
        }

        .popular-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--accent);
            color: var(--dark);
            font-size: 12px;
            font-weight: 800;
            padding: 5px 18px;
            border-radius: 50px;
            white-space: nowrap;
        }

        .plan-name { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 20px; color: var(--muted); }
        .featured .plan-name { color: rgba(255,255,255,0.5); }

        .price-main {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 48px;
            font-weight: 900;
            letter-spacing: -2px;
            line-height: 1;
            margin-bottom: 6px;
        }
        .price-period { font-size: 14px; color: var(--muted); margin-bottom: 28px; }
        .featured .price-period { color: rgba(255,255,255,0.5); }

        .pricing-features { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
        .pricing-features li { display: flex; align-items: center; gap: 10px; font-size: 15px; }
        .pricing-features li::before { content: '✓'; width: 20px; height: 20px; background: #ECFDF5; color: #059669; border-radius: 50%; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .featured .pricing-features li::before { background: rgba(255,255,255,0.1); color: #34D399; }

        .btn-pricing {
            display: block;
            text-align: center;
            padding: 15px;
            border-radius: 12px;
            font-weight: 700;
            text-decoration: none;
            font-size: 16px;
            transition: 0.2s;
        }
        .btn-pricing-free { background: white; color: var(--dark); border: 1px solid var(--border); }
        .btn-pricing-free:hover { background: var(--bg); }
        .btn-pricing-pro { background: var(--accent); color: var(--dark); }
        .btn-pricing-pro:hover { background: #FBBF24; transform: translateY(-2px); }

        /* ─── TESTIMONIALS ─── */
        .testi-section {
            padding: 90px 7%;
            background: var(--bg);
        }

        .testi-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 56px;
        }

        .testi-card {
            background: white;
            border-radius: 18px;
            padding: 30px;
            border: 1px solid var(--border);
            transition: 0.3s;
        }
        .testi-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.06); }

        .stars { color: var(--accent); font-size: 16px; margin-bottom: 16px; letter-spacing: 2px; }
        .testi-text { font-size: 15px; color: #334155; line-height: 1.7; margin-bottom: 20px; font-style: italic; }

        .testi-user { display: flex; align-items: center; gap: 12px; }
        .testi-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border);
        }
        .testi-name { font-weight: 700; font-size: 15px; }
        .testi-role { font-size: 13px; color: var(--muted); }

        /* ─── CTA BANNER ─── */
        .cta-section {
            padding: 90px 7%;
            background: var(--dark);
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .cta-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .cta-section h2 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 48px;
            font-weight: 900;
            color: white;
            letter-spacing: -2px;
            margin-bottom: 18px;
        }
        .cta-section p { font-size: 18px; color: rgba(255,255,255,0.6); margin-bottom: 40px; }
        .btn-cta-big {
            background: var(--accent);
            color: var(--dark);
            padding: 18px 48px;
            border-radius: 14px;
            font-size: 18px;
            font-weight: 800;
            text-decoration: none;
            display: inline-block;
            transition: 0.25s;
        }
        .btn-cta-big:hover { transform: translateY(-3px); background: #FBBF24; box-shadow: 0 15px 40px rgba(245,158,11,0.3); }

        /* ─── FOOTER ─── */
        footer {
            background: #0A0F1E;
            color: rgba(255,255,255,0.5);
            text-align: center;
            padding: 30px;
            font-size: 14px;
        }
        footer span { color: var(--primary); }

        /* ─── RESPONSIVE ─── */
        @media (max-width: 1024px) {
            .hero { grid-template-columns: 1fr; padding: 70px 6% 60px; text-align: center; }
            .hero h1 { font-size: 44px; }
            .hero p { max-width: 100%; margin-left: auto; margin-right: auto; }
            .hero-btns { justify-content: center; }
            .hero-stats { justify-content: center; }
            .hero-visual { display: none; }
            .courses-grid { grid-template-columns: 1fr; }
            .steps-grid { grid-template-columns: repeat(2, 1fr); }
            .steps-grid::before { display: none; }
            .testi-grid { grid-template-columns: 1fr; }
            .pricing-grid { grid-template-columns: 1fr; max-width: 440px; }
            nav { padding: 14px 5%; }
            .nav-links { display: none; }
            .menu-btn { display: block; }
        }

        @media (max-width: 640px) {
            .hero h1 { font-size: 34px; letter-spacing: -1.5px; }
            .section-header h2 { font-size: 30px; }
            .cta-section h2 { font-size: 32px; }
        }
    </style>
</head>
<body>

<div class="overlay" id="overlay"></div>

<!-- NAVBAR -->
<nav>
    <a href="/" class="logo">AMINA <span>Académie</span></a>

    <div class="nav-links">
        <a href="#courses">Formations</a>
        <a href="#pricing">Tarifs</a>
        <a href="#testimonials">Témoignages</a>
        <a href="/login" class="btn-nav-login">Se connecter</a>
        <a href="/register" class="btn-nav-cta">Commencer gratuitement</a>
    </div>

    <button class="menu-btn" id="openMenu">☰</button>
</nav>

<!-- MOBILE SIDEBAR -->
<div class="mob-sidebar" id="mobSidebar">
    <div class="mob-close" id="closeSidebar">✕</div>
    <a href="#courses">Formations</a>
    <a href="#pricing">Tarifs</a>
    <a href="#testimonials">Témoignages</a>
    <a href="/login">Se connecter</a>
    <a href="/register" class="mob-cta">Commencer gratuitement →</a>
</div>

<!-- HERO -->
<section class="hero">
    <div class="hero-content">
        <div class="eyebrow">Plateforme N°1 au Maroc</div>
        <h1>Comptabilité.<br><em>Anglais.</em><br>Marketing.</h1>
        <p>Maîtrisez les 3 compétences qui font la différence sur le marché marocain. Des formations 100% pratiques, conçues pour accélérer votre carrière.</p>
        <div class="hero-btns">
            <a href="/register" class="btn-main">Commencer gratuitement</a>
            <a href="#courses" class="btn-ghost">Voir les formations ↓</a>
        </div>
        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-num">3</span>
                <span class="stat-label">Formations complètes</span>
            </div>
            <div class="stat-item">
                <span class="stat-num">100%</span>
                <span class="stat-label">Pratique</span>
            </div>
            <div class="stat-item">
                <span class="stat-num">🇲🇦</span>
                <span class="stat-label">Adapté au Maroc</span>
            </div>
        </div>
    </div>

    <!-- Dashboard Mockup -->
    <div class="hero-visual">
        <div class="hero-card-stack">
            <div class="float-badge-1">
                <span>🔥</span> <span>+47 XP aujourd'hui</span>
            </div>
            <div class="dashboard-mock">
                <div class="mock-topbar">
                    <div class="mock-dot" style="background:#FF5F57"></div>
                    <div class="mock-dot" style="background:#FFBD2E"></div>
                    <div class="mock-dot" style="background:#28CA41"></div>
                    <span class="mock-title">AMINA Académie — Tableau de Bord</span>
                </div>
                <div class="mock-body">
                    <div class="mock-greeting">Bienvenue, Youssef 👋</div>
                    <div class="mock-courses">
                        <div class="mock-course-row">
                            <div class="mock-icon" style="background:#EEF2FF">💼</div>
                            <div class="mock-info">
                                <div class="mock-course-name">Comptabilité Marocaine</div>
                                <div class="mock-prog-bar"><div class="mock-prog-fill" style="width:72%;background:#4338CA"></div></div>
                            </div>
                            <span style="font-size:12px;font-weight:700;color:#4338CA">72%</span>
                        </div>
                        <div class="mock-course-row">
