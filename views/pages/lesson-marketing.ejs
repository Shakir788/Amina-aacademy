<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marketing Premium | Amina Academy</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0F172A;       
            --ink-light: #334155; 
            --surface: #F8FAFC;   
            --card: #FFFFFF;      
            --accent: #4F46E5;    
            --accent-hover: #4338CA;
            --danger: #EF4444;    
            --success: #10B981;   
            --border: #E2E8F0;    
            --font-display: 'Plus Jakarta Sans', sans-serif;
            --font-body: 'Inter', sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--surface);
            font-family: var(--font-body);
            color: var(--ink);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        /* ───── NAV (Clean) ───── */
        nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 15px 24px;
            display: flex; align-items: center; gap: 20px;
        }
        .close-btn {
            width: 40px; height: 40px; border-radius: 50%;
            background: #F1F5F9; border: none; cursor: pointer;
            font-size: 20px; color: var(--ink-light);
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; transition: 0.2s; font-weight: bold;
        }
        .close-btn:hover { background: #FEE2E2; color: var(--danger); }

        .progress-wrap { flex: 1; background: var(--border); border-radius: 99px; height: 10px; overflow: hidden; }
        .progress-fill { height: 100%; background: var(--accent); width: 0%; transition: width 0.5s ease-in-out; border-radius: 99px; }
        
        .xp-pill {
            background: #EEF2FF; color: var(--accent);
            padding: 8px 16px; border-radius: 99px;
            font-weight: 700; font-size: 15px; font-family: var(--font-display);
        }
        .step-counter { font-size: 14px; font-weight: 700; color: var(--ink-light); }
        
        /* Language Pills */
        .lang-pill { padding: 6px 12px; border-radius: 99px; border: 1px solid var(--border); background: white; font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.2s; color: var(--ink-light); }
        .lang-pill.active { background: var(--accent); color: white; border-color: var(--accent); }

        /* ───── MAIN LAYOUT ───── */
        .page-wrap {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; padding: 40px 20px;
            max-width: 750px; margin: 0 auto; width: 100%;
        }

        .lesson-card {
            background: var(--card); border-radius: 24px;
            border: 1px solid var(--border); width: 100%;
            box-shadow: 0 12px 30px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        /* Hero Gradient (Instead of Image) */
        .hero-gradient {
            background: linear-gradient(135deg, #1E1B4B 0%, #4F46E5 100%);
            padding: 40px; color: white; position: relative;
        }
        .lesson-chip {
            display: inline-block; background: rgba(255,255,255,0.2); color: white;
            padding: 6px 14px; border-radius: 8px; font-family: var(--font-display);
            font-size: 12px; font-weight: 800; text-transform: uppercase;
            letter-spacing: 1.5px; margin-bottom: 16px; border: 1px solid rgba(255,255,255,0.3);
        }
        .lesson-title {
            font-family: var(--font-display); font-size: 34px;
            font-weight: 800; line-height: 1.2; margin-bottom: 10px;
        }
        .lesson-concept { font-size: 18px; font-weight: 500; opacity: 0.9; line-height: 1.5; }

        .card-body { padding: 40px; }

        /* Section Titles */
        .section { margin-bottom: 35px; }
        .section-title {
            font-family: var(--font-display); font-size: 13px; font-weight: 800;
            color: var(--ink-light); text-transform: uppercase; letter-spacing: 1.5px;
            margin-bottom: 16px; display: flex; align-items: center; gap: 10px;
        }
        .section-title::after { content: ''; flex: 1; height: 2px; background: #F1F5F9; }

        /* ───── CONTENT BLOCKS ───── */
        .explain-box { background: #F8FAFC; border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
        .explain-box p { font-size: 17px; line-height: 1.7; color: var(--ink-light); margin-bottom: 16px; }
        .explain-box p:last-child { margin-bottom: 0; }
        
        .explain-truth {
            background: #FEF2F2; border: 1px solid #FECDD3; border-radius: 12px;
            padding: 16px; font-size: 16px; color: #9F1239; font-weight: 600;
            margin-top: 16px; display: flex; align-items: flex-start; gap: 10px; line-height: 1.5;
        }

        /* Lists */
        .list-container { display: flex; flex-direction: column; gap: 12px; }
        .list-item {
            border-radius: 16px; padding: 16px 20px; font-size: 16px;
            font-weight: 500; display: flex; gap: 15px; align-items: flex-start; line-height: 1.5;
        }
        
        .item-good { background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; }
        .item-bad { background: #FFF1F2; border: 1px solid #FECDD3; color: #9F1239; }
        .item-neutral { background: #F8FAFC; border: 1px solid var(--border); color: var(--ink); }

        /* Breakdown Box */
        .breakdown-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
        .bd-card { border-radius: 14px; padding: 16px; font-size: 15px; font-weight: 600; line-height: 1.5; }
        .bd-label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; opacity: 0.8; }

        /* Business Task & Challenge */
        .biz-box {
            background: #FFFFFF; border: 1px solid var(--border); border-radius: 16px;
            padding: 20px; display: flex; gap: 15px; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }
        .biz-icon { width: 50px; height: 50px; border-radius: 12px; background: #EEF2FF; color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; }
        
        .challenge-box {
            background: linear-gradient(135deg, #0F172A, #1E293B); border-radius: 16px;
            padding: 24px; color: white; box-shadow: 0 8px 20px rgba(15, 23, 42, 0.2);
        }
        .challenge-header { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #94A3B8; margin-bottom: 10px; }
        .challenge-task { font-size: 18px; font-weight: 700; line-height: 1.5; margin-bottom: 15px; }

        /* ───── NAVIGATION BUTTONS ───── */
        .nav-buttons { display: flex; gap: 15px; margin-top: 40px; width: 100%; }
        .btn-action {
            border: none; border-radius: 20px; padding: 22px;
            font-family: var(--font-display); font-size: 18px; font-weight: 700;
            cursor: pointer; transition: 0.3s;
        }
        .btn-prev { flex: 1; background: #F1F5F9; color: var(--ink-light); }
        .btn-prev:hover { background: #E2E8F0; }
        
        .btn-next {
            flex: 2; background: var(--accent); color: white;
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
        }
        .btn-next:hover { background: var(--accent-hover); transform: translateY(-3px); box-shadow: 0 12px 25px rgba(79, 70, 229, 0.35); }

        /* ───── WIN SCREEN ───── */
        .win-screen { display: none; text-align: center; padding: 60px 20px; width: 100%; }
        .win-trophy { font-size: 90px; margin-bottom: 25px; }
        .win-title { font-family: var(--font-display); font-size: 36px; font-weight: 800; margin-bottom: 15px; color: var(--ink); }
        .win-sub { color: var(--ink-light); font-size: 18px; margin-bottom: 40px; line-height: 1.6; }
        
        @media (max-width: 600px) {
            .hero-gradient { padding: 30px 20px; }
            .card-body { padding: 25px 20px; }
            .lesson-title { font-size: 28px; }
            .explain-box p { font-size: 16px; }
            .list-item { font-size: 15px; padding: 16px; }
            .btn-action { font-size: 16px; padding: 18px; }
        }
    </style>
</head>
<body>

<nav>
    <a href="/dashboard" class="close-btn">✕</a>
    <div class="progress-wrap"><div class="progress-fill" id="progressFill"></div></div>
    
    <div style="display: flex; gap: 5px;">
        <button class="lang-pill" onclick="switchLang('fr', this)">FR</button>
        <button class="lang-pill" onclick="switchLang('en', this)">EN</button>
        <button class="lang-pill" onclick="switchLang('ar', this)">AR</button>
    </div>

    <span class="step-counter" id="stepCounter">1 / 10</span>
    <div class="xp-pill">⭐ <span id="xpHeader"><%= user.xp || 0 %></span> XP</div>
</nav>

<div class="page-wrap">
    <div class="lesson-card" id="lessonCard">
        <div id="cardBody"></div>
    </div>

    <div class="win-screen" id="winScreen">
        <div class="win-trophy">👑</div>
        <h1 class="win-title">Mode Dieu Activé !</h1>
        <p class="win-sub">Vous maîtrisez maintenant les systèmes de contenu viral.<br>Prêt à dominer internet.</p>
        <button class="btn-action btn-next" style="width: 100%; margin-top: 0;" onclick="finishMission()">Retour au Dashboard ➔</button>
    </div>
</div>

<%- include('../partials/ai-coach') %>

<script id="lesson-data" type="application/json"><%- JSON.stringify(lesson || {}) %></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
const rawData = JSON.parse(document.getElementById('lesson-data').textContent);
const LESSON_ID = parseInt("<%= lessonId %>");
const COURSE = "<%= courseType %>";
let steps = Array.isArray(rawData) ? rawData : (rawData.lessons || [rawData]);

// Language Persistence
let currentLang = localStorage.getItem('siteLang') || 'fr';

// Memory Persistence
const memoryKey = `pos_${COURSE}_${LESSON_ID}`;
let cursor = parseInt(localStorage.getItem(memoryKey)) || 0;
if (cursor >= steps.length) cursor = 0;

let totalXpGained = 0;

// Switcher Logic
function switchLang(lang, btn) {
    currentLang = lang;
    localStorage.setItem('siteLang', lang);
    document.querySelectorAll('.lang-pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
    render();
}

function lang(obj) {
    if (!obj) return '';
    if (typeof obj === 'string') return obj;
    return obj[currentLang] || obj.fr || obj.en || obj.ar || Object.values(obj)[0] || '';
}

function langArr(obj) {
    if (!obj) return [];
    if (Array.isArray(obj)) return obj.map(o => lang(o));
    if (obj[currentLang]) return Array.isArray(obj[currentLang]) ? obj[currentLang] : [obj[currentLang]];
    if (obj.fr) return Array.isArray(obj.fr) ? obj.fr : [obj.fr];
    return [];
}

// UI Builders
function section(icon, title, html) { 
    return `<div class="section"><div class="section-title">${icon} ${title}</div>${html}</div>`; 
}

function render() {
    const step = steps[cursor];

    // Progress Update
    document.getElementById('stepCounter').innerText = `${cursor + 1} / ${steps.length}`;
    document.getElementById('progressFill').style.width = `${((cursor + 1) / steps.length) * 100}%`;

    let html = `
        <div class="hero-gradient">
            <div class="lesson-chip">Module ${cursor + 1}</div>
            <h1 class="lesson-title">${lang(step.title)}</h1>
            <div style="font-size: 16px; opacity: 0.9;">${lang(step.core_concept || step.concept)}</div>
        </div>
        <div class="card-body">
    `;

    // 1. Deep Explanation
    if (step.deep_explanation) {
        const de = step.deep_explanation;
        let expHtml = `<div class="explain-box">`;
        if (de.summary) expHtml += `<p>${lang(de.summary)}</p>`;
        if (de.why_it_matters) expHtml += `<p><strong>Pourquoi c'est important :</strong> ${lang(de.why_it_matters)}</p>`;
        if (de.internet_truth) expHtml += `<div class="explain-truth">⚠️ <span>${lang(de.internet_truth)}</span></div>`;
        expHtml += `</div>`;
        html += section('🧠', 'Compréhension Profonde', expHtml);
    }

    // 2. Automated Lists
    const listFields = ['psychology','hook_types','visual_systems','emotion_types','retention_systems',
                        'psychology_systems','story_systems','trend_systems','mindset_training',
                        'audience_psychology','simulation_systems', 'advanced_story_psychology'];
    
    listFields.forEach(f => {
        if (step[f]) {
            const arr = langArr(step[f]);
            if (arr.length) {
                let listHtml = `<div class="list-container">`;
                arr.forEach(item => { listHtml += `<div class="list-item item-neutral">💡 ${item}</div>`; });
                listHtml += `</div>`;
                html += section('⚙️', f.replace(/_/g,' ').toUpperCase(), listHtml);
            }
        }
    });

    // 3. Examples & Mistakes
    if (step.real_examples) {
        let lHtml = `<div class="list-container">`;
        langArr(step.real_examples).forEach(i => { lHtml += `<div class="list-item item-good">${i}</div>`; });
        lHtml += `</div>`;
        html += section('✅', 'Exemples Réels', lHtml);
    }

    if (step.common_mistakes) {
        let lHtml = `<div class="list-container">`;
        langArr(step.common_mistakes).forEach(i => { lHtml += `<div class="list-item item-bad">${i}</div>`; });
        lHtml += `</div>`;
        html += section('❌', 'Erreurs Fatales', lHtml);
    }

    // 4. Breakdown
    const bdFields = ['viral_analysis','hook_breakdown','caption_breakdown'];
    bdFields.forEach(f => {
        if (step[f]) {
            const bd = step[f];
            const bad = lang(bd.bad || bd.weak_intro || bd.problem);
            const good = lang(bd.good || bd.better_version);
            if (bad || good) {
                let bdHtml = `<div class="breakdown-grid">`;
                if(bad) bdHtml += `<div class="bd-card item-bad"><div class="bd-label">❌ Faible</div>${bad}</div>`;
                if(good) bdHtml += `<div class="bd-card item-good"><div class="bd-label">✅ Puissant</div>${good}</div>`;
                bdHtml += `</div>`;
                html += section('🔄', 'Analyse Comparative', bdHtml);
            }
        }
    });

    // 5. Missions
    const missions = langArr(step.missions || step.final_missions);
    if (missions.length > 0) {
        let lHtml = `<div class="list-container">`;
        missions.forEach((m, idx) => { lHtml += `<div class="list-item item-neutral"><b>${idx+1}.</b> ${m}</div>`; });
        lHtml += `</div>`;
        html += section('🎯', 'Vos Missions', lHtml);
    }

    // 6. Business Task
    if (step.real_business_task) {
        const rbt = step.real_business_task;
        html += section('🏢', 'Application Business', `
            <div class="biz-box">
                <div class="biz-icon">💼</div>
                <div>
                    <div style="font-size:11px; font-weight:800; color:#64748B; text-transform:uppercase; margin-bottom:4px;">${lang(rbt.industry)}</div>
                    <div style="font-size:16px; font-weight:600;">${lang(rbt.task)}</div>
                </div>
            </div>
        `);
    }

    // 7. Pro Secrets & AI
    if (step.pro_secrets) {
        let lHtml = `<div class="list-container">`;
        langArr(step.pro_secrets).forEach(i => { lHtml += `<div class="list-item item-neutral" style="background:#0F172A; color:white; border:none;">⚡ ${i}</div>`; });
        lHtml += `</div>`;
        html += section('🔐', 'Secrets de Pro', lHtml);
    }
    
    if (step.ai_feedback_examples) {
        let lHtml = `<div class="list-container">`;
        langArr(step.ai_feedback_examples).forEach(i => { lHtml += `<div class="list-item item-neutral" style="background:#EEF2FF; border-color:#C7D2FE;">🤖 ${i}</div>`; });
        lHtml += `</div>`;
        html += section('🧠', 'Réactions de l\'Algorithme', lHtml);
    }

    // 8. Challenge
    if (step.challenge_mode) {
        const ch = step.challenge_mode;
        html += section('🏆', 'Mode Défi', `
            <div class="challenge-box">
                <div class="challenge-header">Défi Premium</div>
                <div class="challenge-task">${lang(ch.task || ch.instruction)}</div>
                <div style="background:rgba(255,255,255,0.2); display:inline-block; padding:5px 12px; border-radius:50px; font-size:12px; font-weight:700;">⭐ +${ch.reward_xp || 100} XP</div>
            </div>
        `);
    }

    // Nav Buttons
    html += `
        <div class="nav-buttons">
            ${cursor > 0 ? `<button class="btn-action btn-prev" onclick="handlePrev()">← Retour</button>` : ''}
            <button class="btn-action btn-next" onclick="handleNext()">
                ${cursor < steps.length - 1 ? 'Continuer ➔' : 'Terminer le Module 🏆'}
            </button>
        </div>
        </div>
    `;
    
    document.getElementById('cardBody').innerHTML = html;
}

window.handlePrev = () => { if (cursor > 0) { cursor--; localStorage.setItem(memoryKey, cursor); window.scrollTo({ top: 0, behavior: 'smooth' }); render(); } };

window.handleNext = () => {
    const currentXp = steps[cursor].xp || 50;
    totalXpGained += currentXp;
    document.getElementById('xpHeader').innerText = parseInt(document.getElementById('xpHeader').innerText) + currentXp;
    cursor++;
    if (cursor < steps.length) { localStorage.setItem(memoryKey, cursor); window.scrollTo({ top: 0, behavior: 'smooth' }); render(); }
    else { localStorage.removeItem(memoryKey); document.getElementById('lessonCard').style.display = 'none'; document.getElementById('winScreen').style.display = 'block'; confetti({ particleCount: 200, spread: 100, origin: { y: 0.5 } }); }
};

window.finishMission = async () => {
    try {
        await fetch('/api/progress/complete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lessonId: LESSON_ID, courseType: COURSE, xpEarned: totalXpGained })
        });
    } catch(e) {}
    window.location.href = '/dashboard';
};

window.onload = () => {
    const btns = document.querySelectorAll('.lang-pill');
    btns.forEach(b => b.classList.toggle('active', b.innerText.toLowerCase() === currentLang));
    document.documentElement.dir = (currentLang === 'ar') ? 'rtl' : 'ltr';
    render();
};
</script>
</body>
</html>