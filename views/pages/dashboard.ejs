<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    
    <title>Tableau de Bord - AMINA Académie</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --brand-dark:  #0B1120;
            --brand:       #1E3A8A;
            --accent-gold: #F59E0B;
            --bg-page:     #F8FAFC;
            --surface:     #FFFFFF;
            --text-main:   #0F172A;
            --text-muted:  #64748B;
            --border-soft: rgba(226, 232, 240, 0.8);
            --shadow-sm:   0 2px 10px rgba(0,0,0,0.02);
            --shadow-md:   0 10px 30px rgba(11, 17, 32, 0.08);
            --shadow-hover:0 20px 40px rgba(11, 17, 32, 0.12);
        }

        body { 
            margin: 0; padding: 0; 
            background-color: var(--bg-page); 
            font-family: 'Inter', sans-serif; 
            overflow-x: hidden;
            color: var(--text-main);
            -webkit-font-smoothing: antialiased;
        }

        /* 🚀 1. Ultra-Premium Glass Sidebar */
        .sidebar {
            width: 280px; height: 100vh;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            position: fixed; left: 0; top: 0;
            border-right: 1px solid var(--border-soft);
            display: flex; flex-direction: column;
            padding: 32px 24px; box-sizing: border-box;
            z-index: 1000;
            box-shadow: var(--shadow-sm);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .main-content {
            margin-left: 280px;
            width: calc(100% - 280px);
            padding: 32px 48px 80px;
            box-sizing: border-box;
            transition: margin-left 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Mobile Overlay Backdrop */
        .sidebar-overlay {
            position: fixed; inset: 0; background: rgba(11, 17, 32, 0.4);
            backdrop-filter: blur(4px); z-index: 999;
            opacity: 0; pointer-events: none; transition: opacity 0.3s;
        }

      /* Hamburger Button */
        .hamburger-btn {
            background: var(--surface);
            border: 1px solid var(--border-soft);
            color: var(--text-main);
            border-radius: 12px;
            width: 48px; height: 48px;
            font-size: 24px; cursor: pointer;
            display: flex;
            align-items: center; justify-content: center;
            margin-bottom: 24px;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
        }
        .hamburger-btn:active { transform: scale(0.95); }

        /* Desktop Collapse Classes */
        .sidebar.collapsed { transform: translateX(-100%); }
        .main-content.expanded { margin-left: 0; width: 100%; }

        /* Sidebar Elements */
        .sidebar .logo { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; margin-bottom: 48px; display: block; text-decoration: none; font-weight: 900; color: var(--brand-dark); letter-spacing: -0.5px; }
        .sidebar .logo span { color: var(--accent-gold); }
        .sidebar-section-title { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 16px; letter-spacing: 0.8px; }
        
        /* 🎮 4. Gamification 2.0 */
        .sidebar-gamification { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
        .gami-badge { 
            display: flex; align-items: center; gap: 12px; 
            background: var(--surface); padding: 14px 18px; 
            border-radius: 14px; font-weight: 700; font-size: 15px; 
            border: 1px solid var(--border-soft); transition: all 0.3s ease; 
            box-shadow: var(--shadow-sm);
        }
        .gami-badge:hover { transform: translateX(4px); box-shadow: var(--shadow-md); border-color: transparent; }
        
        .gami-streak { color: #EA580C; background: linear-gradient(to right, #FFFFFF, #FFF7ED); } 
        .gami-xp { color: var(--brand); background: linear-gradient(to right, #FFFFFF, #EFF6FF); }    
        .gami-pro { 
            color: #92400E; background: linear-gradient(135deg, #FEF3C7, #FDE68A); 
            border: none; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.2);
        } 

        .sidebar-spacer { flex-grow: 1; }

        .sidebar-actions { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
        .btn-upgrade { 
            background: linear-gradient(135deg, var(--accent-gold), #D97706); 
            color: white; padding: 14px 20px; border-radius: 14px; font-weight: 800; font-size: 15px; 
            text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px; 
            box-shadow: 0 8px 20px rgba(217, 119, 6, 0.3); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
            border: none; cursor: pointer; 
        }
        .btn-upgrade:hover { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(217, 119, 6, 0.4); }

        .sidebar-profile { background: var(--bg-page); padding: 16px; border-radius: 16px; display: flex; flex-direction: column; gap: 12px; border: 1px solid var(--border-soft); }
        .user-name-display { font-weight: 700; color: var(--brand-dark); display: flex; align-items: center; gap: 8px; font-size: 15px; }
        .btn-logout { background: var(--surface); color: var(--text-muted); padding: 10px; border-radius: 10px; text-align: center; font-weight: 600; font-size: 13px; text-decoration: none; border: 1px solid var(--border-soft); transition: 0.2s; }
        .btn-logout:hover { background: #FEF2F2; color: #DC2626; border-color: #FECACA; }

        /* Welcome Banner */
        .welcome-banner { margin-top: 0; margin-bottom: 24px; }
        .welcome-banner h1 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 32px; font-weight: 900; letter-spacing: -1px; color: var(--brand-dark); margin: 8px 0 12px; }
        .gold-subtitle { font-size: 13px; font-weight: 800; color: var(--accent-gold); text-transform: uppercase; letter-spacing: 1px; }
        .banner-stats { display: flex; gap: 16px; margin-top: 20px; flex-wrap: wrap;}
        .stat { background: var(--surface); border: 1px solid var(--border-soft); padding: 8px 16px; border-radius: 50px; font-size: 13px; font-weight: 600; box-shadow: var(--shadow-sm);}

        /* 🤖 3. Amina AI Coach Widget */
        .ai-coach-banner {
            background: linear-gradient(135deg, var(--brand-dark), #1E293B);
            border-radius: 20px;
            padding: 24px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 48px;
            box-shadow: 0 10px 30px rgba(11, 17, 32, 0.15);
            border: 1px solid rgba(255,255,255,0.1);
            position: relative;
            overflow: hidden;
        }
        .ai-coach-banner::after { content: ''; position: absolute; top: 0; right: 0; width: 150px; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.03)); transform: skewX(-15deg); }
        .ai-info { display: flex; align-items: center; gap: 20px; z-index: 1;}
        .ai-avatar { width: 56px; height: 56px; background: linear-gradient(135deg, #3B82F6, #8B5CF6); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); }
        .ai-text h4 { color: white; margin: 0 0 6px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; }
        .ai-text p { color: #94A3B8; margin: 0; font-size: 14px; line-height: 1.5; max-width: 400px; }
        .ai-action-btn { background: var(--surface); color: var(--brand-dark); padding: 12px 24px; border-radius: 12px; font-weight: 700; text-decoration: none; font-size: 14px; transition: all 0.3s; z-index: 1; box-shadow: 0 4px 15px rgba(0,0,0,0.2);}
        .ai-action-btn:hover { transform: scale(1.05); }

        /* Track Titles */
        .track-title { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 800; margin-bottom: 16px; display: flex; align-items: center; gap: 12px; letter-spacing: -0.5px; }
        .track-title span { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: var(--text-muted); background: var(--surface); border: 1px solid var(--border-soft); padding: 6px 12px; border-radius: 50px; }

        /* --- High-End Carousel & Cards --- */
        .carousel-container { position: relative; width: 100%; margin-bottom: 56px; }
        .lesson-grid { 
            display: flex !important; flex-wrap: nowrap !important; 
            overflow-x: auto; scroll-behavior: smooth; gap: 24px; 
            padding: 10px 0px 40px 0px; width: 100%; 
            scrollbar-width: none; 
            scroll-snap-type: x mandatory; /* Snap on swipe */
        }
        .lesson-grid::-webkit-scrollbar { display: none; }
        
        .lesson-card { 
            overflow: hidden; border-radius: 20px; background: var(--surface); 
            border: 1px solid var(--border-soft); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
            flex: 0 0 320px; max-width: 320px; 
            scroll-snap-align: start; /* Snap alignment */
            position: relative;
        }
        .lesson-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-hover); border-color: transparent; }

        .lesson-card .card-img { 
            height: 180px; background-size: cover; background-position: center; 
            position: relative; transition: all 0.5s ease;
        }
        .lesson-card .card-img::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(to top, rgba(11,17,32,0.6) 0%, transparent 50%);
        }
        .lesson-card:hover .card-img { transform: scale(1.05); }
        .locked-lesson .card-img { filter: grayscale(100%); }
        .locked-lesson:hover .card-img { transform: scale(1); filter: grayscale(100%); }
        
        .badge { position: absolute; top: 16px; left: 16px; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; z-index: 2; backdrop-filter: blur(4px); }
        .badge-success { background: rgba(16, 185, 129, 0.9); color: white; }
        .badge-locked { background: rgba(15, 23, 42, 0.8); color: white; border: 1px solid rgba(255,255,255,0.2); }

        .card-content { padding: 24px; position: relative; z-index: 2; background: var(--surface); }
        .lesson-number { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 32px; font-weight: 900; opacity: 0.1; position: absolute; top: 16px; right: 24px; line-height: 1; }
        .card-text h3 { font-size: 18px; font-weight: 800; color: var(--brand-dark); margin: 0 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.3px;}
        .card-text p { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; line-height: 1.5; }
        
        .btn { display: inline-block; width: 100%; text-align: center; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 14px; text-decoration: none; transition: 0.2s; border: none; box-sizing: border-box; cursor: pointer; }
        .btn-primary { background: var(--brand); color: white; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2); }
        .btn-primary:hover { background: #172554; box-shadow: 0 6px 16px rgba(30, 58, 138, 0.3); }
        .btn-disabled { background: #F1F5F9; color: #94A3B8; pointer-events: none; }
        .btn-premium { background: linear-gradient(135deg, var(--accent-gold), #D97706); color: white; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3); }
        .btn-premium:hover { box-shadow: 0 6px 16px rgba(245, 158, 11, 0.4); transform: translateY(-2px); }

        /* Scroll Buttons */
        .scroll-btn { 
            position: absolute; top: 40%; transform: translateY(-50%); 
            background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);
            border: 1px solid var(--border-soft); color: var(--brand-dark); 
            width: 56px; height: 56px; border-radius: 50%; font-size: 20px; cursor: pointer; 
            z-index: 10; box-shadow: var(--shadow-md); transition: all 0.2s ease; 
            display: flex; align-items: center; justify-content: center; 
        }
        .scroll-btn:hover { background: var(--brand-dark); color: white; transform: translateY(-50%) scale(1.05); }
        .scroll-btn.left { left: -28px; }
        .scroll-btn.right { right: -28px; }

        /* 📱 2. Mobile-First & Touch Optimization */
        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); width: 300px; padding: 24px; }
            .sidebar.mobile-open { transform: translateX(0); }
            
            .main-content { margin-left: 0; width: 100%; padding: 20px 20px 80px; }
            
            .sidebar-overlay.active { opacity: 1; pointer-events: auto; }

            .ai-coach-banner { flex-direction: column; align-items: flex-start; padding: 20px; gap: 16px; }
            .ai-action-btn { width: 100%; text-align: center; }

            /* Touch Optimized Carousels */
            .lesson-grid { padding-bottom: 20px; gap: 16px; }
            .lesson-card { flex: 0 0 85%; max-width: 320px; }
            .scroll-btn { display: none; } /* Hide buttons on mobile, rely on smooth swipe */
            
            .welcome-banner h1 { font-size: 26px; }
        }
    </style>
</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="sidebar" id="sidebar">
        <a href="/dashboard" class="logo">AMINA <span>Académie</span></a>
        
        <% const isPremiumUser = user && user.subscription && user.subscription.plan === 'premium'; %>
        <% const isAdmin = user && user.role === 'admin'; %>

        <div class="sidebar-section-title">Vos Statistiques</div>
        <div class="sidebar-gamification">
            <div class="gami-badge gami-streak">
                🔥 <%= user.streak && user.streak.current > 0 ? user.streak.current : 0 %> Jours
            </div>
            <div class="gami-badge gami-xp">
                ⭐ <%= user.xp || 0 %> XP
            </div>
            <% if(isPremiumUser || isAdmin) { %>
                <div class="gami-badge gami-pro">
                    👑 Membre PRO
                </div>
            <% } %>
        </div>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-actions">
            <% if(isAdmin) { %>
                <a href="/admin/dashboard" class="btn-upgrade" style="background: var(--brand-dark); box-shadow: 0 8px 20px rgba(11, 17, 32, 0.3);">🛠️ Panel Admin</a>
            <% } %>
            <% if(!isPremiumUser && !isAdmin) { %>
                <a href="/premium" class="btn-upgrade">👑 Go Premium</a>
            <% } %>
        </div>

        <div class="sidebar-profile">
            <div class="user-name-display">👨‍💼 <%= user.name %></div>
            <a href="/api/auth/logout" class="btn-logout">Déconnexion</a>
        </div>
    </aside>

    <main class="main-content" id="mainContent">
        
        <button class="hamburger-btn" id="toggleSidebarBtn">☰</button>
        
        <div class="welcome-banner">
            <span class="gold-subtitle">Espace d'apprentissage VIP</span>
            <h1>Bienvenue, <%= user.name %> !</h1>
            <p style="color: var(--text-muted); font-size: 15px; max-width: 600px; line-height: 1.6; margin: 0;">Développez vos compétences en comptabilité, maîtrisez l'anglais, et dominez le marketing digital.</p>
            
            <div class="banner-stats">
                <div class="stat">💼 Finance</div>
                <div class="stat">🇬🇧 English</div>
                <div class="stat">📱 Marketing</div>
            </div>
        </div>

        <div class="ai-coach-banner">
            <div class="ai-info">
                <div class="ai-avatar">✨</div>
                <div class="ai-text">
                    <h4>Amina AI te conseille :</h4>
                    <p>Tu es sur une belle lancée ! Continue ta mission en comptabilité pour sécuriser ton streak d'aujourd'hui.</p>
                </div>
            </div>
            <a href="#accTrack" class="ai-action-btn">Reprendre la leçon 🚀</a>
        </div>

        <% 
        const mktLessons = (typeof marketingLessons !== 'undefined' && marketingLessons.length > 0) ? marketingLessons : [
            {id: 1, title: {fr: "Viral Content Brain"}, description: {fr: "Hooks + Psychology + Reels"}, isUnlocked: true},
            {id: 2, title: {fr: "Creator System"}, description: {fr: "Design, Édition & Outils IA"}, isUnlocked: true},
            {id: 3, title: {fr: "Money System"}, description: {fr: "Trouver des clients & Négociation"}, isUnlocked: false},
            {id: 4, title: {fr: "Ads & Growth"}, description: {fr: "Meta Ads & Stratégies d'audience"}, isUnlocked: false},
            {id: 5, title: {fr: "AI Domination"}, description: {fr: "Automatisation & Contenu IA"}, isUnlocked: false}
        ]; 
        %>

        <div class="track-title" style="color: #7C3AED;">
            📱 Digital Marketing & Création <span><%= mktLessons.length %> Missions</span>
        </div>

        <div class="carousel-container">
            <button class="scroll-btn left" onclick="scrollGrid('mktGrid', 'left')">❮</button>
            <div class="lesson-grid" id="mktGrid">
                <% 
                const marketingImages = [
                    'https://images.unsplash.com/photo-1611162617474-5b21e879e113?q=80&w=800',
                    'https://images.unsplash.com/photo-1557838923-2985c318be48?q=80&w=800',
                    'https://images.unsplash.com/photo-1533750516457-a7f992034fec?q=80&w=800',
                    'https://images.unsplash.com/photo-1432888117247-36e5a4f81014?q=80&w=800',
                    'https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=800' 
                ];
                %>

                <% mktLessons.forEach(function(lesson) { %>
                    <% 
                        const imgUrl = lesson.imageUrl ? lesson.imageUrl : marketingImages[(lesson.id - 1) % marketingImages.length];
                        const formattedNum = lesson.id < 10 ? '0' + lesson.id : lesson.id;
                        let isAvailable = lesson.isUnlocked;
                        let needsUpgrade = false;
                        if (!isPremiumUser && !isAdmin && lesson.id > 4) {
                         isAvailable = false; needsUpgrade = true;
}

                        // Smart fallback for JSON multilingual structure
                        const titleDisplay = (typeof lesson.title === 'object') ? (lesson.title.fr || lesson.title.en) : lesson.title;
                        const descDisplay = (typeof lesson.description === 'object') ? (lesson.description.fr || lesson.description.en) : lesson.description;
                    %>
                    <div class="lesson-card <%= isAvailable ? 'active-lesson' : 'locked-lesson' %>">
                        <div class="card-img" style="background-image: url('<%= imgUrl %>');">
                            <% if(needsUpgrade) { %>
                                <span class="badge" style="background: #f59e0b; color: white;">👑 Premium</span>
                            <% } else { %>
                                <span class="badge <%= isAvailable ? 'badge-success' : 'badge-locked' %>">
                                    <%= isAvailable ? '● Disponible' : '🔒 Bloqué' %>
                                </span>
                            <% } %>
                        </div>
                        <div class="card-content">
                            <span class="lesson-number" style="color:#7C3AED;"><%= formattedNum %></span>
                            <div class="card-text">
                                <h3><%= titleDisplay %></h3>
                                <p><%= descDisplay %></p>
                            </div>
                            
                            <% if(needsUpgrade) { %>
                                <a href="/premium" class="btn btn-premium">👑 Débloquer</a>
                            <% } else { %>
                               <a href="<%= isAvailable ? '/lesson/marketing/' + lesson.id : '#' %>" class="btn <%= isAvailable ? 'btn-primary' : 'btn-disabled' %>" <%- isAvailable ? 'style="background-color: #7C3AED;"' : '' %>>
                                    <%= isAvailable ? 'Démarrer' : 'Bloqué' %>
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
            <button class="scroll-btn right" onclick="scrollGrid('mktGrid', 'right')">❯</button>
        </div>

        <div class="track-title" style="color: #4f46e5;">
            🇬🇧 English Mastery <span><%= englishLessons.length %> Sessions</span>
        </div>

        <div class="carousel-container">
            <button class="scroll-btn left" onclick="scrollGrid('engGrid', 'left')">❮</button>
            <div class="lesson-grid" id="engGrid">
                <% 
                const englishImages = [
                    'https://images.unsplash.com/photo-1546410531-bb4caa6b424d?q=80&w=800',
                    'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=800',
                    'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?q=80&w=800'
                ];
                %>

                <% englishLessons.forEach(function(lesson) { %>
                    <% 
                        const imgUrl = lesson.imageUrl ? lesson.imageUrl : englishImages[(lesson.id - 1) % englishImages.length];
                        const formattedNum = lesson.id < 10 ? '0' + lesson.id : lesson.id;
                        let isAvailable = lesson.isUnlocked;
                        let needsUpgrade = false;
                        if (!isPremiumUser && !isAdmin && lesson.id > 4) {
                            isAvailable = false; needsUpgrade = true;
                        }

                        // Smart fallback for JSON multilingual structure
                        const titleDisplay = (typeof lesson.title === 'object') ? (lesson.title.fr || lesson.title.en) : lesson.title;
                        const descDisplay = (typeof lesson.description === 'object') ? (lesson.description.fr || lesson.description.en) : lesson.description;
                    %>
                    <div class="lesson-card <%= isAvailable ? 'active-lesson' : 'locked-lesson' %>">
                        <div class="card-img" style="background-image: url('<%= imgUrl %>');">
                            <% if(needsUpgrade) { %>
                                <span class="badge" style="background: #f59e0b; color: white;">👑 Premium</span>
                            <% } else { %>
                                <span class="badge <%= isAvailable ? 'badge-success' : 'badge-locked' %>">
                                    <%= isAvailable ? '● Disponible' : '🔒 Bloqué' %>
                                </span>
                            <% } %>
                        </div>
                        <div class="card-content">
                            <span class="lesson-number" style="color:#4f46e5;"><%= formattedNum %></span>
                            <div class="card-text">
                                <h3><%= titleDisplay %></h3>
                                <p><%= descDisplay %></p>
                            </div>
                            
                            <% if(needsUpgrade) { %>
                                <a href="/premium" class="btn btn-premium">👑 Débloquer</a>
                            <% } else { %>
                                <a href="<%= isAvailable ? '/lesson/english/' + lesson.id : '#' %>" class="btn <%= isAvailable ? 'btn-primary' : 'btn-disabled' %>" <%- isAvailable ? 'style="background-color: #4f46e5;"' : '' %>>
                                    <%= isAvailable ? 'Apprendre' : 'Bloqué' %>
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
            <button class="scroll-btn right" onclick="scrollGrid('engGrid', 'right')">❯</button>
        </div>


        <div class="track-title" id="accTrack" style="color: #0f766e;">
            💼 Accounting Empire <span><%= accountingLessons.length %> Leçons</span>
        </div>

        <div class="carousel-container">
            <button class="scroll-btn left" onclick="scrollGrid('accGrid', 'left')">❮</button>
            <div class="lesson-grid" id="accGrid">
                <% 
                const accountingImages = [
                    'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=800',
                    'https://images.unsplash.com/photo-1611095790444-1dfa35e37b52?q=80&w=800',
                    'https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800'
                ];
                %>

                <% accountingLessons.forEach(function(lesson) { %>
                    <% 
                        const imgUrl = lesson.imageUrl ? lesson.imageUrl : accountingImages[(lesson.id - 1) % accountingImages.length];
                        const formattedNum = lesson.id < 10 ? '0' + lesson.id : lesson.id;
                        let isAvailable = lesson.isUnlocked;
                        let needsUpgrade = false;
                        if (!isPremiumUser && !isAdmin && lesson.id > 4) {
                            isAvailable = false; needsUpgrade = true;
                        }

                        // Smart fallback for JSON multilingual structure
                        const titleDisplay = (typeof lesson.title === 'object') ? (lesson.title.fr || lesson.title.en) : lesson.title;
                        const descDisplay = (typeof lesson.description === 'object') ? (lesson.description.fr || lesson.description.en) : lesson.description;
                    %>
                    <div class="lesson-card <%= isAvailable ? 'active-lesson' : 'locked-lesson' %>">
                        <div class="card-img" style="background-image: url('<%= imgUrl %>');">
                            <% if(needsUpgrade) { %>
                                <span class="badge" style="background: #f59e0b; color: white;">👑 Premium</span>
                            <% } else { %>
                                <span class="badge <%= isAvailable ? 'badge-success' : 'badge-locked' %>">
                                    <%= isAvailable ? '● Disponible' : '🔒 Verrouillé' %>
                                </span>
                            <% } %>
                        </div>
                        <div class="card-content">
                            <span class="lesson-number" style="color:#0f766e;"><%= formattedNum %></span>
                            <div class="card-text">
                                <h3><%= titleDisplay %></h3>
                                <p><%= descDisplay %></p>
                            </div>
                            
                            <% if(needsUpgrade) { %>
                                <a href="/premium" class="btn btn-premium">👑 Débloquer</a>
                            <% } else { %>
                                <a href="<%= isAvailable ? '/lesson/accounting/' + lesson.id : '#' %>" class="btn <%= isAvailable ? 'btn-primary' : 'btn-disabled' %>" <%- isAvailable ? 'style="background-color: #0f766e;"' : '' %>>
                                    <%= isAvailable ? 'Commencer' : 'Bloqué' %>
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
            <button class="scroll-btn right" onclick="scrollGrid('accGrid', 'right')">❯</button>
        </div>

    </main>

    <script>
        // 📱 Smart Sidebar Logic (Desktop + Mobile)
        const toggleBtn = document.getElementById('toggleSidebarBtn');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const mainContent = document.getElementById('mainContent');

        function toggleMenu() {
            if (window.innerWidth > 900) {
                // Desktop Toggle
                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('expanded');
            } else {
                // Mobile Toggle
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('active');
                document.body.style.overflow = sidebar.classList.contains('mobile-open') ? 'hidden' : '';
            }
        }

        toggleBtn.addEventListener('click', toggleMenu);
        overlay.addEventListener('click', toggleMenu);

        // Netflix Style Scroll (For Desktop)
        function scrollGrid(gridId, direction) {
            const grid = document.getElementById(gridId);
            const scrollAmount = grid.clientWidth > 800 ? 700 : 350; 
            if (direction === 'left') {
                grid.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            } else {
                grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            }
        }

        window.addEventListener('pageshow', function (event) {
            if (event.persisted) window.location.reload(); 
        });
    </script>

</body>
</html>