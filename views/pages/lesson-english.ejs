<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Session <%= lessonId %> | English Mastery</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #4F46E5;
            --primary-hover: #4338CA;
            --success: #10B981;
            --warning: #F59E0B;
            --error: #EF4444;
            --bg-color: #F8FAFC;
            --card-bg: #FFFFFF;
            --text-main: #0F172A;
            --text-muted: #64748B;
        }

        body {
            background-color: var(--bg-color); font-family: 'Inter', sans-serif;
            margin: 0; padding: 0; color: var(--text-main);
            display: flex; flex-direction: column; min-height: 100vh;
        }

        nav {
            background: white; padding: 15px 5%; display: flex; justify-content: space-between;
            align-items: center; border-bottom: 2px solid #E2E8F0; position: sticky; top: 0; z-index: 100;
        }
        .nav-left { display: flex; align-items: center; gap: 15px; }
        .back-btn { color: var(--text-muted); text-decoration: none; font-size: 24px; font-weight: bold; transition: 0.2s; }
        .back-btn:hover { color: var(--error); transform: scale(1.1); }

        .progress-container { flex: 1; max-width: 300px; background: #E2E8F0; height: 12px; border-radius: 20px; overflow: hidden; margin: 0 20px; }
        .progress-bar { height: 100%; background: var(--success); width: 0%; transition: width 0.5s ease; }
        
        .stats-badge { display: flex; gap: 10px; }
        .streak-badge, .xp-badge { padding: 5px 12px; border-radius: 50px; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 5px; }
        .streak-badge { background: #FEF3C7; color: #D97706; }
        .xp-badge { background: #E0E7FF; color: var(--primary); }

        .game-container {
            flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; 
            padding: 20px; max-width: 600px; margin: 0 auto; width: 100%; box-sizing: border-box;
        }

        .flashcard {
            background: var(--card-bg); width: 100%; border-radius: 24px; padding: 25px 30px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05); border: 2px solid #E2E8F0;
            text-align: center; transition: all 0.3s ease; position: relative;
        }

        .status-badge {
            position: absolute; top: -15px; left: 50%; transform: translateX(-50%);
            background: var(--primary); color: white; padding: 5px 15px; border-radius: 20px;
            font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
        }

        .emotion-display { font-size: 18px; margin-bottom: 10px; background: #F1F5F9; display: inline-block; padding: 5px 15px; border-radius: 12px; border: 1px solid #E2E8F0; display: none; }
        .exercise-img { width: 100%; height: 200px; object-fit: cover; border-radius: 16px; margin-bottom: 20px; display: none; }
        .exercise-img.active { display: block; }
        .pronunciation { font-size: 15px; color: var(--primary); background: #EEF2FF; display: inline-block; padding: 4px 12px; border-radius: 8px; margin-bottom: 10px; font-weight: 600; letter-spacing: 1px;}
        .target-sentence { font-family: 'Plus Jakarta Sans'; font-size: 32px; font-weight: 800; color: var(--text-main); margin: 0 0 20px; line-height: 1.3; }
        
        .trap-box { background: #FFF1F2; border: 1px dashed #FB7185; padding: 12px; border-radius: 12px; margin-bottom: 20px; color: #9F1239; font-size: 14px; text-align: left; display: none; }

        .translation-box { background: #F8FAFC; border: 1px solid #E2E8F0; padding: 15px; border-radius: 12px; margin-bottom: 25px; text-align: left; }
        .trans-row { display: flex; justify-content: space-between; margin-bottom: 8px; align-items: center; font-size: 15px; }
        .lang-label { font-weight: 700; color: var(--text-muted); font-size: 12px; text-transform: uppercase; width: 60px; }
        .trans-fr { color: #334155; flex: 1; }
        .trans-darija { color: #0F766E; font-weight: 600; flex: 1; }
        .trans-ar { font-size: 18px; font-weight: 600; color: var(--text-main); text-align: right; flex: 1; font-family: 'Arial', sans-serif; }

        .grammar-hint { background: #FFFBEB; border-left: 4px solid var(--warning); padding: 15px; text-align: left; font-size: 14px; color: #92400E; border-radius: 0 8px 8px 0; margin-bottom: 25px; display: none; }
        .grammar-hint.active { display: block; }

        .tools-area { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; font-size: 12px; color: var(--text-muted); }
        .speed-btn { border: 1px solid #E2E8F0; background: white; padding: 4px 8px; border-radius: 6px; cursor: pointer; }
        .speed-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

        .action-area { display: flex; flex-direction: column; gap: 15px; width: 100%; }
        .btn-action { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 18px; border-radius: 16px; font-size: 18px; font-weight: 700; border: none; cursor: pointer; transition: 0.3s; }
        .btn-listen { background: #F1F5F9; color: var(--text-main); border: 2px solid #CBD5E1; }
        .btn-speak { background: var(--primary); color: white; box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3); }
        .btn-speak.listening { background: var(--error); animation: pulse 1.5s infinite; }
        .btn-next { background: var(--success); color: white; display: none; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3); }

        .feedback-msg { margin-top: 15px; font-size: 15px; text-align: left; padding: 15px; border-radius: 12px; display: none; }
        .feedback-success { background: #D1FAE5; color: #065F46; display: block; text-align: center; font-weight: 700;}
        .feedback-error { background: #FEE2E2; color: #991B1B; display: block; }

        .repeat-tracker { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
        .dot { width: 12px; height: 12px; border-radius: 50%; background: #E2E8F0; }
        .dot.filled { background: var(--success); }

        .final-screen { display: none; text-align: center; }
        @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.02); } 100% { transform: scale(1); } }
    </style>
</head>
<body>

    <nav>
        <div class="nav-left"><a href="/dashboard" class="back-btn">✕</a></div>
        <div class="progress-container"><div class="progress-bar" id="progressBar"></div></div>
        <div class="stats-badge">
            <div class="xp-badge">⭐ <span id="xpCounter"><%= user.xp || 0 %></span> XP</div>
            <div class="streak-badge">🔥 <span><%= user.streak.current || 0 %></span></div>
        </div>
    </nav>

    <div class="game-container">
        <div class="flashcard" id="learningCard">
            <div class="status-badge" id="stepIndicator">1 / 5</div>
            <img src="" class="exercise-img" id="exerciseImg">
            <div class="emotion-display" id="emotionDisplay">friendly</div>
            <div class="pronunciation" id="pronunciation">...</div>
            <div class="target-sentence" id="targetSentence">Loading...</div>
            
            <div class="trap-box" id="trapBox">⚠️ <b>Attention Trap:</b> <span id="trapText"></span></div>

            <div class="translation-box" id="transBoxMain">
                <div class="trans-row"><span class="lang-label">Fr</span> <span class="trans-fr" id="transFr">...</span></div>
                <div class="trans-row"><span class="lang-label">Dar</span> <span class="trans-darija" id="transDarija">...</span></div>
                <div class="trans-row"><span class="lang-label">Ar</span> <span class="trans-ar" dir="rtl" id="transAr">...</span></div>
            </div>

            <div class="grammar-hint" id="grammarHint">💡 <b>Indice:</b> <span id="hintText">...</span></div>

            <div class="tools-area">
                <span>Vitesse:</span>
                <button class="speed-btn" onclick="updateSpeed(0.6)">0.6x</button>
                <button class="speed-btn active" id="speedNormal" onclick="updateSpeed(0.85)">Normal</button>
                <button class="speed-btn" onclick="updateSpeed(1.1)">Rapid</button>
            </div>

            <div class="repeat-tracker"><div class="dot" id="dot1"></div><div class="dot" id="dot2"></div></div>

            <div class="action-area">
                <button class="btn-action btn-listen" id="btnListen" onclick="playAudio()">🔊 Écouter</button>
                <button class="btn-action btn-speak" id="btnSpeak" onclick="startSpeaking()">🎤 Parler</button>
                <button class="btn-action btn-next" id="btnNext" onclick="nextCard()">Continue ➔</button>
            </div>
            <div class="feedback-msg" id="feedbackMsg"></div>
        </div>

        <div class="final-screen" id="finalScreen">
            <div style="font-size: 80px; margin-bottom: 20px;">🏆</div>
            <h1 style="font-size: 32px; font-weight: 800; margin-bottom: 10px;">Phase Terminée!</h1>
            <p style="color: #64748B; font-size: 18px; margin-bottom: 30px;">+ <span id="finalXp">0</span> XP gagnés.</p>
            <button class="btn-action btn-speak" style="max-width: 300px; margin: 0 auto;" onclick="finishSession()">Retour au Hub</button>
        </div>
    </div>

    <%- include('../partials/ai-coach') %>

    <script id="lesson-data" type="application/json"><%- JSON.stringify(lesson || {}) %></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        window.CURRENT_COURSE_TYPE = "<%= courseType %>";
        const rawData = JSON.parse(document.getElementById('lesson-data').textContent);
        const CURRENT_LESSON_ID = parseInt("<%= lessonId %>");

        let exercises = [];
        let phaseSystemInfo = null;

        // --- 🚀 AGGREGATOR ENGINE (Collects 30 lessons into one list) ---
        if (rawData.lessons) {
            phaseSystemInfo = rawData; 
            rawData.lessons.forEach(l => { if(l.exercises) exercises = exercises.concat(l.exercises); });
        } else if (Array.isArray(rawData)) {
            rawData.forEach(l => { if(l.exercises) exercises = exercises.concat(l.exercises); });
        } else {
            exercises = rawData.exercises || [];
        }

        // --- 🧠 MEMORY ENGINE (Load last saved position) ---
        const storageKey = `last_pos_${window.CURRENT_COURSE_TYPE}_${CURRENT_LESSON_ID}`;
        let currentIndex = parseInt(localStorage.getItem(storageKey)) || 0;
        
        // Safety: If someone changed the JSON and the saved index is now too high
        if (currentIndex >= exercises.length) currentIndex = 0;

        let sessionXp = 0;
        let requiredSuccess = 2; 
        let currentSuccess = 0;
        let playbackRate = 0.85;
        let weakExercises = [];

        // TTS setup
        const synth = window.speechSynthesis;
        let femaleVoice = null;
        function setVoice() {
            const voices = synth.getVoices();
            femaleVoice = voices.find(v => v.name.includes('Google UK English Female') || v.name.includes('Zira') || v.name.includes('Samantha')) || voices[0];
        }
        if (speechSynthesis.onvoiceschanged !== undefined) speechSynthesis.onvoiceschanged = setVoice;

        window.updateSpeed = function(rate) {
            playbackRate = rate;
            document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');
        };

        window.playAudio = function() {
            synth.cancel();
            const utter = new SpeechSynthesisUtterance(exercises[currentIndex].en);
            if (femaleVoice) utter.voice = femaleVoice;
            utter.lang = 'en-US'; utter.rate = playbackRate;
            synth.speak(utter);
        };

        // Speech Recognition
        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition;
        if (SpeechRec) {
            recognition = new SpeechRec();
            recognition.lang = 'en-US';
            recognition.onstart = () => { 
                document.getElementById('btnSpeak').classList.add('listening');
                document.getElementById('btnSpeak').innerHTML = '🎧 Je vous écoute...';
            };
            recognition.onresult = (e) => {
                const said = e.results[0][0].transcript.toLowerCase().trim();
                const target = exercises[currentIndex].en.toLowerCase().replace(/[^\w\s\']/g, "").trim();
                const cleanSpeech = said.replace(/[^\w\s\']/g, "").trim();

                let matched = (cleanSpeech.includes(target) || target.includes(cleanSpeech));
                if (!matched && exercises[currentIndex].variations) {
                    for(let v of exercises[currentIndex].variations) {
                        if(cleanSpeech.includes(v.toLowerCase().trim())) { matched = true; break; }
                    }
                }

                if (matched) handleSuccess();
                else {
                    if(!weakExercises.includes(exercises[currentIndex])) weakExercises.push(exercises[currentIndex]);
                    handleFailure(said, exercises[currentIndex].en);
                }
            };
            recognition.onend = () => { document.getElementById('btnSpeak').classList.remove('listening'); };
        }

        window.startSpeaking = () => { if(recognition) try { recognition.start(); } catch(e) {} };

        function loadCard() {
            if (!exercises[currentIndex]) return;
            const ex = exercises[currentIndex];
            currentSuccess = 0;
            updateDots();

            // UI Refresh
            document.getElementById('targetSentence').innerText = ex.en;
            document.getElementById('pronunciation').innerText = `🗣️ ${ex.pronunciation?.simple || ex.pronunciation || '...'}`;
            document.getElementById('transFr').innerText = ex.fr || ex.french || '...';
            document.getElementById('transDarija').innerText = ex.darija || '...';
            document.getElementById('transAr').innerText = ex.ar || ex.arabic || '...';

            const img = document.getElementById('exerciseImg');
            if (ex.imageUrl) { img.src = ex.imageUrl; img.classList.add('active'); } else { img.classList.remove('active'); }

            const trap = document.getElementById('trapBox');
            if(ex.listening_trap) { trap.style.display = 'block'; document.getElementById('trapText').innerText = ex.listening_trap; } else { trap.style.display = 'none'; }

            const emo = document.getElementById('emotionDisplay');
            if(ex.emotion) { emo.style.display = 'inline-block'; emo.innerText = Array.isArray(ex.emotion) ? ex.emotion[0] : ex.emotion; } else { emo.style.display = 'none'; }

            const hint = document.getElementById('grammarHint');
            const hText = ex.context || ex.hint;
            if(hText) { hint.classList.add('active'); document.getElementById('hintText').innerText = hText; } else { hint.classList.remove('active'); }

            document.getElementById('stepIndicator').innerText = `${currentIndex + 1} / ${exercises.length}`;
            document.getElementById('progressBar').style.width = `${(currentIndex / exercises.length) * 100}%`;
            
            document.getElementById('btnNext').style.display = 'none';
            document.getElementById('btnSpeak').style.display = 'flex';
            document.getElementById('btnSpeak').innerHTML = '🎤 Parler';
            document.getElementById('feedbackMsg').style.display = 'none';

            // Auto-play / Shadowing
            if(currentIndex > 0 || (phaseSystemInfo && phaseSystemInfo.system?.includes("Shadowing"))) {
                setTimeout(() => playAudio(), 600);
            }
        }

        function updateDots() {
            document.getElementById('dot1').className = currentSuccess >= 1 ? 'dot filled' : 'dot';
            document.getElementById('dot2').className = currentSuccess >= 2 ? 'dot filled' : 'dot';
        }

        function handleSuccess() {
            currentSuccess++; updateDots(); sessionXp += 10;
            document.getElementById('xpCounter').innerText = parseInt(document.getElementById('xpCounter').innerText) + 10;
            const f = document.getElementById('feedbackMsg');
            f.className = 'feedback-msg feedback-success';
            if (currentSuccess < requiredSuccess) {
                f.innerHTML = '🔥 Super ! Répétez encore une fois.';
                document.getElementById('btnSpeak').innerHTML = '🎤 Parler (Encore)';
            } else {
                f.innerHTML = '🎉 Parfait !';
                document.getElementById('btnSpeak').style.display = 'none';
                document.getElementById('btnNext').style.display = 'flex';
            }
            f.style.display = 'block';
        }

        function handleFailure(said, target) {
            const f = document.getElementById('feedbackMsg');
            f.className = 'feedback-msg feedback-error';
            f.innerHTML = `<b>Oups, presque!</b><span>🗣️ <b>Vous:</b> "${said}"</span><span>🎯 <b>Correct:</b> "${target}"</span>`;
            f.style.display = 'block';
            document.getElementById('btnSpeak').innerHTML = '🎤 Réessayer';
            if (window.triggerAICoachError) window.triggerAICoachError(said, target);
        }

        window.nextCard = () => {
            currentIndex++;
            
            // 🧠 SAVE POSITION (Memory update)
            localStorage.setItem(storageKey, currentIndex);

            if (currentIndex < exercises.length) loadCard();
            else {
                if(weakExercises.length > 0) {
                    alert("On révise les points faibles ! 💪");
                    exercises = [...weakExercises]; weakExercises = []; currentIndex = 0; loadCard();
                } else {
                    document.getElementById('learningCard').style.display = 'none';
                    document.getElementById('finalScreen').style.display = 'block';
                    document.getElementById('finalXp').innerText = sessionXp;
                    
                    // 🧠 CLEANUP (Mission complete, reset position for next time)
                    localStorage.removeItem(storageKey);
                    confetti({ particleCount: 150, spread: 70 });
                }
            }
        };

        window.finishSession = async () => {
            try {
                await fetch('/api/progress/complete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ lessonId: CURRENT_LESSON_ID, courseType: window.CURRENT_COURSE_TYPE, xpEarned: sessionXp })
                });
                window.location.href = '/dashboard';
            } catch(e) { window.location.href = '/dashboard'; }
        };

        window.onload = loadCard;
    </script>
</body>
</html>