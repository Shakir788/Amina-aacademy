<!DOCTYPE html>
<html lang="fr" id="pageLang">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leçon <%= lessonId %> — AMINA Académie</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

    <% const fallbackImg = 'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=1200'; %>

    <style>
        /* ══════════════════════════════════════════
           LEDGER SYSTEM — design tokens
           Grounded in real accounting stationery:
           a red margin rule, ruled paper, ink colors
           tied to "dans le vert / dans le rouge"
           ══════════════════════════════════════════ */
        :root {
            --ink:          #1B2420;
            --ink-soft:     #5B655D;
            --ledger:       #2F5D45;
            --ledger-deep:  #1F4432;
            --ledger-tint:  #E9F0E9;
            --brass:        #AD7F35;
            --brass-tint:   #F6EDD8;
            --margin-red:   #B24B36;
            --rule:         #DAD3BC;
            --paper:        #F6F3E9;
            --paper-card:   #FCFAF3;
            --white:        #FFFFFF;
            --danger:       #B24B36;
            --danger-tint:  #FBEBE5;
            --radius-lg:    4px;
            --radius-md:    3px;
            --font-display: 'Fraunces', serif;
            --font-body:    'IBM Plex Sans', 'IBM Plex Sans Arabic', sans-serif;
            --font-mono:    'IBM Plex Mono', monospace;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: var(--font-body);
            background: var(--paper);
            color: var(--ink);
            min-height: 100vh;
            background-image: repeating-linear-gradient(
                to bottom,
                transparent,
                transparent 30px,
                rgba(47,93,69,0.055) 31px
            );
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
        }

        /* ─── PROGRESS RULE (ink filling a line) ─── */
        #progress-bar-wrap {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--rule);
            z-index: 2000;
        }
        #progress-bar-fill {
            height: 100%;
            background: var(--ledger);
            width: 0%;
            transition: width 0.25s ease-out;
            position: relative;
        }
        #progress-bar-fill::after {
            content: '';
            position: absolute;
            right: -2px; top: -1.5px;
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--brass);
        }

        /* ─── CUSTOM TOAST ALERTS ─── */
        #custom-toast {
            position: fixed; bottom: -100px; right: 24px;
            background: var(--paper-card); border: 1px solid var(--ink); border-left: 4px solid var(--ledger);
            padding: 16px 24px; font-family: var(--font-body); font-size: 14px; font-weight: 500;
            box-shadow: 4px 4px 0 var(--rule); z-index: 9999; 
            transition: bottom 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        #custom-toast.show { bottom: 24px; }
        #custom-toast.error-toast { border-left-color: var(--danger); }

        /* ─── NAV: ledger page header ─── */
        nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: var(--paper-card);
            border-bottom: 1px solid var(--ink);
            box-shadow: 0 2px 0 var(--rule);
            padding: 0 5%;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .nav-left { display: flex; align-items: center; gap: 16px; }

        .logo {
            font-family: var(--font-display);
            font-size: 19px;
            font-weight: 700;
            font-style: italic;
            color: var(--ink);
            text-decoration: none;
            letter-spacing: -0.2px;
            white-space: nowrap;
        }
        .logo span { color: var(--ledger); font-style: normal; }

        .nav-divider { width: 1px; height: 20px; background: var(--rule); }

        .lesson-breadcrumb {
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 500;
            color: var(--ink-soft);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 260px;
            letter-spacing: 0.2px;
        }

        .nav-right { display: flex; align-items: center; gap: 18px; }

        .ledger-balance {
            display: flex;
            align-items: baseline;
            gap: 6px;
            font-family: var(--font-mono);
        }
        .ledger-balance .lb-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--ink-soft);
        }
        .ledger-balance .lb-value {
            font-size: 15px;
            font-weight: 600;
            color: var(--ledger);
        }
        .ledger-balance.streak .lb-value { color: var(--brass); }
        .balance-divider { width: 1px; height: 16px; background: var(--rule); }

        .lang-switcher { display: flex; }
        .btn-lang {
            border: 1px solid var(--rule);
            border-left: none;
            background: var(--white);
            padding: 6px 12px;
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 11px;
            letter-spacing: 0.4px;
            cursor: pointer;
            color: var(--ink-soft);
            transition: 0.15s;
        }
        .lang-switcher .btn-lang:first-child { border-left: 1px solid var(--rule); border-radius: var(--radius-md) 0 0 var(--radius-md); }
        .lang-switcher .btn-lang:last-child { border-radius: 0 var(--radius-md) var(--radius-md) 0; }
        .btn-lang.active { background: var(--ink); color: var(--paper-card); border-color: var(--ink); }
        .btn-lang:hover:not(.active) { background: var(--ledger-tint); }

        /* ─── LAYOUT: ledger sheet with ruled margin column ─── */
        .lesson-layout {
            max-width: 760px; /* TIGHTENED FOR READABILITY */
            margin: 0 auto;
            padding: 48px 24px 120px 96px;
            position: relative;
        }
        .margin-rule {
            position: absolute;
            left: 68px;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--margin-red);
            opacity: 0.55;
        }

        .entry-number {
            position: absolute;
            left: -52px;
            top: 4px;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 600;
            color: var(--margin-red);
            letter-spacing: 0.3px;
        }

        /* ─── SKELETON LOADING ─── */
        @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
        .skeleton {
            background: linear-gradient(90deg, #E9F0E9 25%, #F6F3E9 50%, #E9F0E9 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            color: transparent !important;
            border-radius: 4px;
            display: inline-block;
        }

        /* ─── LESSON HERO ─── */
        .lesson-hero { margin-bottom: 44px; position: relative; }

        .lesson-meta {
            display: flex;
            align-items: center;
            gap: 0;
            margin-bottom: 20px;
            flex-wrap: wrap;
            font-family: var(--font-mono);
            font-size: 11px;
            border: 1px solid var(--rule);
            width: fit-content;
        }
        .meta-tag {
            padding: 7px 14px;
            color: var(--ink-soft);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-right: 1px solid var(--rule);
        }
        .meta-tag:last-child { border-right: none; }
        .meta-tag.accounting { color: var(--ledger); font-weight: 600; background: var(--ledger-tint); }

        .lesson-hero h1 {
            font-family: var(--font-display);
            font-size: 40px;
            font-weight: 600;
            line-height: 1.12;
            letter-spacing: -0.5px;
            color: var(--ink);
            margin-bottom: 14px;
        }

        .lesson-subtitle {
            font-size: 16px;
            color: var(--ink-soft);
            line-height: 1.65;
            max-width: 620px;
        }

        .hero-doc {
            display: inline-block;
            margin-top: 30px;
            padding: 10px 10px 14px;
            background: var(--white);
            border: 1px solid var(--rule);
            box-shadow: 3px 4px 0 var(--rule);
            transform: rotate(-0.6deg);
            filter: sepia(0.2) contrast(0.95);
        }
        .hero-doc img {
            width: 100%;
            max-width: 520px;
            height: 260px;
            object-fit: cover;
            display: block;
        }
        .hero-doc-caption {
            font-family: var(--font-mono);
            font-size: 10px;
            color: var(--ink-soft);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding-top: 8px;
        }

        /* ─── SECTION BLOCKS: ledger entries ─── */
        .lesson-block {
            background: var(--paper-card);
            border: 1px solid var(--rule);
            border-left: 3px solid var(--ledger);
            margin-bottom: 22px;
            position: relative;
        }
        .lesson-block.blk-gold { border-left-color: var(--brass); }
        .lesson-block.blk-dark { border-left-color: var(--ink); }

        .block-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 26px;
            border-bottom: 1px solid var(--rule);
        }
        .block-icon {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--ledger);
            flex-shrink: 0;
        }
        .blk-gold .block-icon { color: var(--brass); }
        .blk-dark .block-icon { color: var(--paper); }
        .block-icon svg { width: 20px; height: 20px; stroke-width: 1.6; }

        .block-header h2 {
            font-family: var(--font-display);
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.1px;
            color: var(--ink);
        }
        .blk-dark .block-header h2 { color: var(--paper); }

        .block-badge {
            margin-left: auto;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 500;
            color: var(--ink-soft);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .blk-dark .block-badge { color: #9CA89E; }

        .block-body {
            padding: 26px;
            font-size: 16px;
            line-height: 1.85;
            color: var(--ink);
        }
        .blk-dark { background: var(--ink); }
        .blk-dark .block-header { border-bottom: 1px solid #34403A; }
        .blk-dark .block-body { color: #D6DCD7; }

        [dir="rtl"] .block-body { text-align: right; }

        /* ─── RICH TEXT ─── */
        .block-body b { color: var(--ledger-deep); font-weight: 700; }
        .blk-dark .block-body b { color: var(--brass); }

        .block-body .premium-heading {
            font-family: var(--font-display);
            font-size: 17px;
            font-weight: 600;
            font-style: italic;
            color: var(--ledger-deep);
            margin: 26px 0 10px;
            padding-bottom: 6px;
            border-bottom: 1px solid var(--rule);
        }

        .premium-note {
            display: flex;
            gap: 12px;
            background: var(--brass-tint);
            border-left: 2px solid var(--brass);
            padding: 13px 18px;
            margin: 18px 0;
            font-size: 14.5px;
            color: #5C4419;
        }
        [dir="rtl"] .premium-note { border-left: none; border-right: 2px solid var(--brass); }
        .premium-note::before { content: '§'; font-family: var(--font-display); font-style: italic; font-weight: 700; flex-shrink: 0; color: var(--brass); }

        .premium-list-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 8px 0;
            padding: 9px 4px;
            font-size: 15px;
            border-bottom: 1px dashed var(--rule);
        }
        .premium-list-item::before {
            content: '—';
            color: var(--ledger);
            font-weight: 700;
            flex-shrink: 0;
        }

        /* ─── PRACTICE ZONE: a worksheet ─── */
        .practice-zone {
            background: repeating-linear-gradient(to bottom, var(--white), var(--white) 29px, var(--ledger-tint) 30px);
            border: 1px solid var(--rule);
            padding: 22px 24px;
            margin-top: 18px;
        }
        .pz-question {
            font-family: var(--font-display);
            font-size: 17px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 18px;
        }

        .mcq-options { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
        .mcq-option {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: var(--white);
            border: 1px solid var(--rule);
            cursor: pointer;
            font-size: 15px;
            font-weight: 500;
            transition: 0.15s;
        }
        .mcq-option:hover { border-color: var(--ledger); background: var(--ledger-tint); }
        .mcq-option input[type="radio"] { accent-color: var(--ledger); width: 15px; height: 15px; flex-shrink: 0; }
        .mcq-label-tag { font-family: var(--font-mono); font-size: 11px; background: var(--rule); padding: 2px 6px; border-radius: 2px; color: var(--ink-soft); margin-right: 8px;}

        .pz-input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--rule);
            font-size: 16px;
            font-family: var(--font-mono);
            background: var(--white);
            color: var(--ink);
            margin-bottom: 14px;
        }
        .pz-input:focus { border-color: var(--ledger); outline: 2px solid var(--ledger-tint); outline-offset: 1px; }

        .btn-verify {
            background: var(--ink);
            color: var(--paper);
            border: none;
            padding: 13px 26px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.2px;
            cursor: pointer;
            width: 100%;
            transition: 0.2s;
            font-family: var(--font-body);
        }
        .btn-verify:hover { background: var(--ledger-deep); }
        .btn-verify:focus-visible, .mcq-option:focus-within, .btn-complete:focus-visible, .btn-lang:focus-visible { outline: 2px solid var(--margin-red); outline-offset: 2px; }

        /* Smart Practice Results */
        .pz-result {
            margin-top: 16px;
            padding: 12px 16px;
            font-weight: 500;
            font-size: 14.5px;
            display: none;
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }
        .pz-result-content { display: flex; align-items: center; gap: 10px; width: 100%; }
        .pz-result.success { display: flex; color: var(--ledger-deep); border-left: 2px solid var(--ledger); }
        .pz-result.error   { display: flex; color: var(--danger); border-left: 2px solid var(--danger); background: var(--danger-tint); }
        [dir="rtl"] .pz-result.success, [dir="rtl"] .pz-result.error { border-left: none; }
        
        .btn-solution { background: transparent; border: 1px underline var(--ink-soft); color: var(--ink-soft); font-family: var(--font-mono); font-size: 12px; cursor: pointer; margin-top: 8px; padding: 4px 0;}

        .pz-stamp {
            width: 26px; height: 26px;
            border-radius: 50%;
            border: 1.5px solid currentColor;
            display: flex; align-items: center; justify-content: center;
            font-size: 12px;
            flex-shrink: 0;
            transform: scale(1.5) rotate(-10deg);
            opacity: 0;
            animation: stampDown 0.32s ease-out forwards;
        }
        @keyframes stampDown {
            0%   { transform: scale(1.8) rotate(-18deg); opacity: 0; }
            60%  { transform: scale(0.92) rotate(-8deg); opacity: 1; }
            100% { transform: scale(1) rotate(-8deg); opacity: 1; }
        }

        /* ─── KEY TAKEAWAYS: a totals reconciliation ─── */
        .takeaway-grid { display: flex; flex-direction: column; margin-top: 4px; }
        .takeaway-item {
            display: flex;
            align-items: baseline;
            gap: 12px;
            padding: 13px 0;
            border-bottom: 1px dashed #34403A;
            font-size: 14.5px;
            color: #D6DCD7;
            line-height: 1.5;
        }
        .takeaway-item:last-child { border-bottom: none; }
        .takeaway-item::before {
            content: attr(data-idx);
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--brass);
            flex-shrink: 0;
        }

        /* ─── COMPLETE ACTION ─── */
        .action-wrap { text-align: center; margin-top: 44px; }
        .btn-complete {
            background: var(--ledger);
            color: var(--paper);
            border: none;
            padding: 17px 48px;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.3px;
            cursor: pointer;
            font-family: var(--font-body);
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        .btn-complete:hover { background: var(--ledger-deep); transform: translateY(-1px); }
        .btn-complete:disabled { opacity: 0.75; pointer-events: none; }

        .next-hint {
            margin-top: 14px;
            font-family: var(--font-mono);
            font-size: 11.5px;
            color: var(--ink-soft);
        }

        [dir="rtl"] .lesson-meta, [dir="rtl"] .nav-left { flex-direction: row-reverse; }
        [dir="rtl"] .margin-rule { left: auto; right: 68px; }
        [dir="rtl"] .entry-number { left: auto; right: -52px; }
        [dir="rtl"] .lesson-layout { padding: 48px 96px 120px 24px; }
        [dir="rtl"] .meta-tag { border-right: none; border-left: 1px solid var(--rule); }

        @media (max-width: 720px) {
            .lesson-layout { padding: 40px 20px 100px; }
            .margin-rule, .entry-number { display: none; }
            .lesson-hero h1 { font-size: 27px; }
            .hero-doc img { height: 190px; }
            .block-body { padding: 20px; }
            .lesson-breadcrumb { display: none; }
            .nav-divider { display: none; }
            [dir="rtl"] .lesson-layout { padding: 40px 20px 100px; }
        }
    </style>
</head>
<body>

<div id="progress-bar-wrap"><div id="progress-bar-fill"></div></div>
<div id="custom-toast">Message</div>

<nav>
    <div class="nav-left">
        <a href="/dashboard" class="logo">AMINA <span>Académie</span></a>
        <div class="nav-divider"></div>
        <span class="lesson-breadcrumb" id="navLessonTitle">Leçon <%= lessonId %></span>
    </div>
    <div class="nav-right">
        <div class="ledger-balance">
            <span class="lb-label">Progression</span>
            <span class="lb-value" id="navProgress">0/5</span>
        </div>
        <div class="balance-divider"></div>
        <div class="ledger-balance">
            <span class="lb-label">XP</span>
            <span class="lb-value" id="navXp"><%= user && user.xp ? user.xp : 0 %></span>
        </div>
        <div class="balance-divider"></div>
        <div class="ledger-balance streak">
            <span class="lb-label">Série</span>
            <span class="lb-value"><%= user && user.streak && user.streak.current ? user.streak.current : 0 %>j</span>
        </div>
        <div class="lang-switcher">
            <button type="button" class="btn-lang active" onclick="switchLang('fr','ltr',this)">FR</button>
            <button type="button" class="btn-lang" onclick="switchLang('en','ltr',this)">EN</button>
            <button type="button" class="btn-lang" onclick="switchLang('ar','rtl',this)">AR</button>
        </div>
    </div>
</nav>

<div class="lesson-layout">
    <div class="margin-rule"></div>

    <div class="lesson-hero">
        <div class="lesson-meta">
            <span class="meta-tag accounting">Comptabilité</span>
            <span class="meta-tag">Réf. <%= lessonId %></span>
            <span class="meta-tag">~15 min</span>
        </div>
        <h1 id="lessonTitle" class="skeleton">Chargement…</h1>
        <p class="lesson-subtitle skeleton" id="lessonSubtitle">Préparez-vous à maîtriser un concept clé de la comptabilité marocaine.</p>
        <div class="hero-doc">
            <img id="lessonImg" src="<%= fallbackImg %>" alt="Document de référence de la leçon">
            <div class="hero-doc-caption">Pièce jointe — document de référence</div>
        </div>
    </div>

    <div class="lesson-block blk-blue" data-index="1">
        <span class="entry-number">N&deg;01</span>
        <div class="block-header">
            <div class="block-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="0.5" fill="currentColor"></circle></svg></div>
            <h2 id="lbl-obj">Objectif de la leçon</h2>
            <span class="block-badge">À retenir</span>
        </div>
        <div class="block-body" id="txt-obj"></div>
    </div>

    <div class="lesson-block blk-blue" data-index="2">
        <span class="entry-number">N&deg;02</span>
        <div class="block-header">
            <div class="block-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="1"></rect><line x1="8" y1="9" x2="16" y2="9"></line><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="12" y2="17"></line></svg></div>
            <h2 id="lbl-exp">Explication complète</h2>
            <span class="block-badge">Théorie</span>
        </div>
        <div class="block-body" id="txt-exp"></div>
    </div>

    <div class="lesson-block blk-blue" data-index="3">
        <span class="entry-number">N&deg;03</span>
        <div class="block-header">
            <div class="block-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8Z"></path><path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path><line x1="4" y1="13" x2="20" y2="13"></line></svg></div>
            <h2 id="lbl-exm">Cas pratique</h2>
            <span class="block-badge">Exemple réel</span>
        </div>
        <div class="block-body" id="txt-exm"></div>
    </div>

    <div class="lesson-block blk-gold" data-index="4">
        <span class="entry-number">N&deg;04</span>
        <div class="block-header">
            <div class="block-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1-4L16 5l3 3L8 19l-4 1Z"></path><line x1="13" y1="7" x2="17" y2="11"></line></svg></div>
            <h2 id="lbl-pra">Exercice pratique</h2>
            <span class="block-badge">Challenge</span>
        </div>
        <div class="block-body">
            <div id="txt-pra"></div>
            <div id="dynamic-practice-zone"></div>
        </div>
    </div>

    <div class="lesson-block blk-dark" data-index="5">
        <span class="entry-number">N&deg;05</span>
        <div class="block-header">
            <div class="block-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v14l-4-3H4z"></path><line x1="8" y1="9" x2="16" y2="9"></line></svg></div>
            <h2 id="lbl-res">Points clés à retenir</h2>
            <span class="block-badge">Résumé</span>
        </div>
        <div class="block-body">
            <div id="txt-res-raw" style="display:none"></div>
            <div class="takeaway-grid" id="takeaway-grid"></div>
        </div>
    </div>

    <div class="action-wrap">
        <button type="button" class="btn-complete" id="btn-complete" onclick="markComplete()">
            Marquer comme terminé
        </button>
        <p class="next-hint" id="next-hint">La leçon suivante se débloque automatiquement après validation.</p>
    </div>

</div>

<%- include('../partials/ai-coach') %>

<script id="lesson-data" type="application/json"><%- JSON.stringify(lesson || {}) %></script>

<script>
    window.CURRENT_COURSE_TYPE = "accounting";
    const lessonData = JSON.parse(document.getElementById('lesson-data').textContent);
    const fallbackImageUrl = "<%= fallbackImg %>";
    const CURRENT_LESSON_ID = "<%= lessonId %>";
    let pzAttempts = 0;

    // ─── TOAST NOTIFICATIONS ───
    function showToast(message, isError = false) {
        const toast = document.getElementById('custom-toast');
        toast.textContent = message;
        toast.className = isError ? 'error-toast show' : 'show';
        setTimeout(() => toast.className = '', 4000);
    }

    // ─── READING PROGRESS & BLOCK TRACKER ───
    window.addEventListener('load', () => {
        const blocks = document.querySelectorAll('.lesson-block');
        const progressEl = document.getElementById('navProgress');
        
        if('IntersectionObserver' in window) {
            progressEl.textContent = `0/${blocks.length}`;
            let readBlocks = new Set();
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if(entry.isIntersecting) {
                        readBlocks.add(entry.target.getAttribute('data-index'));
                        progressEl.textContent = `${readBlocks.size}/${blocks.length}`;
                    }
                });
            }, { threshold: 0.6 });
            blocks.forEach(b => observer.observe(b));
        }

        window.addEventListener('scroll', () => {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? (window.scrollY / docH) * 100 : 0;
            document.getElementById('progress-bar-fill').style.width = pct + '%';
        });
    });

    // ─── LABELS ───
    const labels = {
        fr: { obj:"Objectif de la leçon", exp:"Explication complète", exm:"Cas pratique", pra:"Exercice pratique", res:"Points clés à retenir", btn:"Marquer comme terminé", btnDone:"Écriture validée" },
        en: { obj:"Lesson Objective",     exp:"Full Explanation",     exm:"Case Study",  pra:"Practice Task",    res:"Key Takeaways",         btn:"Mark as Completed",     btnDone:"Entry posted" },
        ar: { obj:"هدف الدرس",            exp:"الشرح الكامل",         exm:"مثال تطبيقي", pra:"تطبيق عملي",       res:"نقاط رئيسية",           btn:"تحديد كمكتمل",          btnDone:"تم الترحيل" }
    };

    // ─── RICH TEXT FORMATTER ───
    function format(text) {
        if (!text) return '<span style="color:var(--ink-soft);font-style:italic;">Aucun contenu disponible.</span>';
        let html = text;
        html = html.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
        html = html.replace(/🔹\s*([^\n]+)/g, '<div class="premium-heading">$1</div>');
        html = html.replace(/👍\s*([^\n]+)/g, '<div class="premium-note">$1</div>');
        html = html.replace(/-\s+([^\n]+)/g, '<div class="premium-list-item">$1</div>');
        html = html.replace(/❌/g, '<span style="color:var(--danger);font-weight:700;">✕</span>');
        html = html.replace(/✓/g, '<span style="color:var(--ledger);font-weight:700;">✓</span>');
        html = html.replace(/\n/g, '<br>');
        return html;
    }

    // ─── TAKEAWAYS AS A RECONCILIATION LIST ───
    function buildTakeaways(rawHtml) {
        const grid = document.getElementById('takeaway-grid');
        const lines = rawHtml.split('<br>').map(l => l.replace(/<[^>]+>/g,'').trim()).filter(l => l.length > 10);
        if (lines.length === 0) { grid.innerHTML = '<span style="color:#9CA89E;font-size:14.5px;">Résumé disponible plus haut.</span>'; return; }
        grid.innerHTML = lines.map((l, i) => `<div class="takeaway-item" data-idx="${String(i+1).padStart(2,'0')}">${l}</div>`).join('');
    }

    // ─── PRACTICE ZONE ───
    window.showSolution = function() {
        const pz = lessonData.practice_zone;
        const resultEl = document.getElementById('pz_result');
        resultEl.innerHTML = `<div class="pz-result-content"><span class="pz-stamp" style="border:none">💡</span><b>Solution:</b> La bonne réponse est "${pz.correct_answer}". Reprenez la section Explication pour comprendre le raisonnement.</div>`;
        resultEl.className = 'pz-result success';
    };

    window.checkAnswer = function(inputType) {
        const pz = lessonData.practice_zone;
        const resultEl = document.getElementById('pz_result');
        let userAnswer = '';

        if (inputType === 'radio') {
            const sel = document.querySelector('input[name="pz_radio"]:checked');
            if (!sel) {
                showToast('Sélectionnez une option avant de vérifier.', true);
                return;
            }
            userAnswer = sel.value;
        } else {
            userAnswer = (document.getElementById('pz_input')?.value || '').trim();
            if (!userAnswer) {
                showToast('Entrez une valeur avant de vérifier.', true);
                return;
            }
        }

        if (userAnswer.toString().trim() === pz.correct_answer.toString().trim()) {
            resultEl.className = 'pz-result success';
            resultEl.innerHTML = '<div class="pz-result-content"><span class="pz-stamp">✓</span><span>Correct — écriture équilibrée.</span></div>';
        } else {
            pzAttempts++;
            resultEl.className = 'pz-result error';
            let html = `<div class="pz-result-content"><span class="pz-stamp">✕</span><span>Incorrect. ${pz.explanation || 'Relisez le cas pratique et réessayez.'}</span></div>`;
            if (pzAttempts >= 2) {
                html += `<button class="btn-solution" onclick="showSolution()">Bloqué ? Voir la solution</button>`;
            }
            resultEl.innerHTML = html;
        }
    };

    function renderPracticeZone() {
        const container = document.getElementById('dynamic-practice-zone');
        const pz = lessonData.practice_zone;
        if (!pz || !pz.type) { container.innerHTML = ''; return; }

        let html = '<div class="practice-zone">';
        if (pz.question) {
            html += `<div class="pz-question">${pz.question}</div>`;
        }

        if (['mcq','brand_audit','commitment'].includes(pz.type)) {
            html += '<div class="mcq-options">';
            const chars = ['A', 'B', 'C', 'D'];
            pz.options.forEach((opt, idx) => {
                html += `<label class="mcq-option"><input type="radio" name="pz_radio" value="${opt}"><span class="mcq-label-tag">Compte ${chars[idx] || (idx+1)}</span> ${opt}</label>`;
            });
            html += '</div>';
            html += `<button type="button" class="btn-verify" onclick="checkAnswer('radio')">Vérifier l'écriture</button>`;
        } else {
            html += `<input type="number" id="pz_input" class="pz-input" placeholder="Montant de l'écriture…">`;
            html += `<button type="button" class="btn-verify" onclick="checkAnswer('input')">Calculer &amp; vérifier</button>`;
        }

        html += '<div id="pz_result" class="pz-result"></div>';
        html += '</div>';
        container.innerHTML = html;
    }

    // ─── LANG SWITCH ───
    function switchLang(lang, dir, btnEl) {
        document.documentElement.setAttribute('dir', dir);
        document.documentElement.setAttribute('lang', lang);
        if (btnEl) {
            document.querySelectorAll('.btn-lang').forEach(b => b.classList.remove('active'));
            btnEl.classList.add('active');
        }

        let content = {};
        if (lessonData.content) {
            content = lessonData.content[lang] || lessonData.content || {};
        }

        const l = labels[lang] || labels.fr;

        // Remove skeletons once loaded
        document.getElementById('lessonTitle').classList.remove('skeleton');
        document.getElementById('lessonSubtitle').classList.remove('skeleton');

        let titleText = 'Leçon ' + CURRENT_LESSON_ID;
        if (lessonData.title) {
            titleText = typeof lessonData.title === 'string' ? lessonData.title : (lessonData.title[lang] || lessonData.title.fr || titleText);
        }
        document.getElementById('lessonTitle').textContent = titleText;
        document.getElementById('navLessonTitle').textContent = titleText;

        document.getElementById('lbl-obj').textContent = l.obj;
        document.getElementById('lbl-exp').textContent = l.exp;
        document.getElementById('lbl-exm').textContent = l.exm;
        document.getElementById('lbl-pra').textContent = l.pra;
        document.getElementById('lbl-res').textContent = l.res;
        const btn = document.getElementById('btn-complete');
        if (!btn.disabled) btn.textContent = l.btn;

        document.getElementById('txt-obj').innerHTML = format(content.objectif || lessonData.description || '');
        document.getElementById('txt-exp').innerHTML = format(content.explication || '');
        document.getElementById('txt-exm').innerHTML = format(content.exemple || '');
        document.getElementById('txt-pra').innerHTML = format(content.pratique || '');

        const resumeHtml = format(content.resume || '');
        document.getElementById('txt-res-raw').innerHTML = resumeHtml;
        buildTakeaways(resumeHtml);

        const sub = content.objectif || lessonData.description || '';
        document.getElementById('lessonSubtitle').textContent = sub ? sub.substring(0, 120).replace(/\*\*/g,'') + '…' : '';

        document.getElementById('lessonImg').src = content.imageUrl || lessonData.imageUrl || fallbackImageUrl;
    }

    // ─── MARK COMPLETE ───
    async function markComplete() {
        const btn = document.getElementById('btn-complete');
        const activeLang = document.documentElement.getAttribute('lang') || 'fr';
        const l = labels[activeLang] || labels.fr;
        btn.disabled = true;
        btn.textContent = 'Traitement...';

        try {
            const res = await fetch('/api/progress/complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lessonId: parseInt(CURRENT_LESSON_ID), courseType: CURRENT_COURSE_TYPE })
            });

            if (res.ok) {
                const data = await res.json();

                btn.innerHTML = `<span class="pz-stamp" style="color:var(--paper);border-color:var(--paper);">✓</span> ${l.btnDone}${data.xpGained > 0 ? ' · +' + data.xpGained + ' XP' : ''}`;
                btn.style.background = 'var(--ledger-deep)';

                if (data.totalXp) document.getElementById('navXp').textContent = data.totalXp;

                showToast("Leçon complétée avec succès !");
                document.getElementById('next-hint').textContent = 'Redirection vers la leçon suivante…';

                setTimeout(() => {
                    window.location.href = `/lesson/${CURRENT_COURSE_TYPE}/${parseInt(CURRENT_LESSON_ID) + 1}`;
                }, 1400);

            } else {
                const data = await res.json();
                showToast('Erreur : ' + (data.message || 'Impossible de sauvegarder.'), true);
                btn.disabled = false;
                btn.textContent = l.btn;
            }
        } catch (err) {
            showToast('Erreur de connexion. Vérifiez votre backend.', true);
            btn.disabled = false;
            btn.textContent = l.btn;
        }
    }

    // ─── INIT ───
    window.addEventListener('load', () => {
        switchLang('fr', 'ltr', document.querySelector('.btn-lang.active'));
        renderPracticeZone();
    });

    window.addEventListener('pageshow', e => { if (e.persisted) window.location.reload(); });
</script>
</body>
</html>