    </div>
</div>

<script>
    // ==========================================
    // 1. TEXT CHAT LOGIC (ORIGINAL)
    // ==========================================
    function toggleAIPanel() {
        const panel = document.getElementById('aiPanel');
        panel.style.display = panel.style.display === 'flex' ? 'none' : 'flex';
    }

    function appendAIMessage(text, sender) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `ai-msg-bubble ${sender === 'ai' ? 'ai-system-msg' : 'ai-user-msg'}`;
        msgDiv.innerHTML = text.replace(/\*\*(.*?)\*\*/g, '<b style="color:#fbbf24;">$1</b>');
        document.getElementById('aiMessages').appendChild(msgDiv);
        document.getElementById('aiMessages').scrollTop = document.getElementById('aiMessages').scrollHeight;
    }

    function lockChatWithPaywall(message) {
        const upsellMessage = `
            <div style="background: #FFF1F2; border: 1px solid #FECDD3; border-radius: 12px; padding: 15px; color: #9F1239; margin-top: 10px;">
                <b style="font-size: 16px;">⚠️ Limite Atteinte !</b><br><br>
                ${message}<br><br>
                <a href="/premium" style="display: block; text-align: center; background: linear-gradient(135deg, #d97706, #f59e0b); color: white; padding: 12px; border-radius: 8px; text-decoration: none; font-weight: bold; margin-top: 12px; box-shadow: 0 4px 10px rgba(217, 119, 6, 0.3);">👑 Voir les plans Premium</a>
            </div>
        `;
        appendAIMessage(upsellMessage, 'ai');
        document.getElementById('aiInput').disabled = true;
        document.getElementById('aiInput').placeholder = "Passez en Premium pour continuer...";
        document.getElementById('sendMsgBtn').disabled = true;
        document.getElementById('sttBtn').disabled = true;
    }

    let sttRecognition;
    function toggleSTT() {
        if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
            return alert("Reconnaissance vocale non supportée sur ce navigateur.");
        }
        if(!sttRecognition) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            sttRecognition = new SpeechRecognition();
            sttRecognition.continuous = false;
            sttRecognition.lang = (window.CURRENT_COURSE_TYPE === 'english') ? 'en-US' : 'fr-FR';
            sttRecognition.onstart = () => { document.getElementById('sttBtn').classList.add('recording'); };
            sttRecognition.onresult = (e) => { 
                document.getElementById('aiInput').value = e.results[0][0].transcript; 
                sendTextMessage(); 
            };
            sttRecognition.onend = () => { document.getElementById('sttBtn').classList.remove('recording'); };
            sttRecognition.onerror = (e) => { console.error("STT Error:", e); document.getElementById('sttBtn').classList.remove('recording'); };
        }
        sttRecognition.start();
    }

    window.sendTextMessage = async function() {
        const input = document.getElementById('aiInput');
        const text = input.value.trim();
        if(!text) return;
        input.value = '';
        appendAIMessage(text, 'user');
        const typingId = 'typing-' + Date.now();
        const typingDiv = document.createElement('div');
        typingDiv.className = 'ai-msg-bubble ai-system-msg';
        typingDiv.id = typingId;
        typingDiv.innerHTML = '<span style="color:#64748B; font-style:italic;">Amina écrit...</span>';
        document.getElementById('aiMessages').appendChild(typingDiv);
        document.getElementById('aiMessages').scrollTop = document.getElementById('aiMessages').scrollHeight;

        try {
            const aiRes = await fetch('/api/ai/coach', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userQuestion: text, courseType: window.CURRENT_COURSE_TYPE || 'english' })
            });
            const aiData = await aiRes.json();
            document.getElementById(typingId).remove();
            if (aiData.limitReached) {
                lockChatWithPaywall(aiData.feedback || aiData.message || "Tu as atteint ta limite de messages gratuits.");
                return;
            }
            if(aiData.feedback) { appendAIMessage(aiData.feedback, 'ai'); }
        } catch(e) { 
            document.getElementById(typingId).remove(); 
            appendAIMessage("Erreur de réseau. 😞", 'ai');
        }
    }

    window.triggerAICoachError = async function(whatTheySaid, target) {
        document.getElementById('aiPanel').style.display = 'flex';
        appendAIMessage(`J'ai dit "${whatTheySaid}" au lieu de "${target}". Pourquoi ?`, 'user');
        const typingId = 'typing-' + Date.now();
        const typingDiv = document.createElement('div');
        typingDiv.className = 'ai-msg-bubble ai-system-msg';
        typingDiv.id = typingId;
        typingDiv.innerHTML = '<span style="color:#64748B; font-style:italic;">Amina écrit...</span>';
        document.getElementById('aiMessages').appendChild(typingDiv);
        document.getElementById('aiMessages').scrollTop = document.getElementById('aiMessages').scrollHeight;
        try {
            const aiRes = await fetch('/api/ai/coach', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userSaid: whatTheySaid, correctText: target, courseType: window.CURRENT_COURSE_TYPE || 'english' })
            });
            const aiData = await aiRes.json();
            document.getElementById(typingId).remove();
            if (aiData.limitReached) {
                lockChatWithPaywall(aiData.feedback || aiData.message || "Tu as atteint ta limite de messages gratuits.");
                return;
            }
            if(aiData.feedback) { appendAIMessage(aiData.feedback, 'ai'); }
        } catch(e) {
            document.getElementById(typingId).remove();
            appendAIMessage("Erreur de réseau. 😞", 'ai');
        }
    }

    // ==========================================
    // 2. LIVE CALL LOGIC (FIXED VERSION)
    // ==========================================
    let isCallActive = false;
    let isMuted = false;
    let liveSocket = null;
    let audioStream = null;
    let playbackContext = null;
    let workletNode = null;
    let micAudioContext = null;
    let audioProcessor = null;
    let nextPlayTime = 0;

    async function openLiveCallScreen() {
        toggleAIPanel();
        const callScreen = document.getElementById('liveCallScreen');
        callScreen.style.display = 'flex';
        setTimeout(() => callScreen.classList.add('active'), 10);
        document.getElementById('callStatusText').innerText = "CONNECTING...";
        document.getElementById('callStatusText').style.color = "#fbbf24";
        document.getElementById('liveCaption').innerText = "";
        isCallActive = true;

        try {
            audioStream = await navigator.mediaDevices.getUserMedia({
                audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true, channelCount: 1, sampleRate: 16000 }
            });
            const tokenRes = await fetch('/api/ai/live-token');
            if (tokenRes.status === 403) {
                const errorData = await tokenRes.json();
                if (errorData.limitReached) {
                    closeLiveCallScreen();
                    toggleAIPanel();
                    lockChatWithPaywall("Tu as atteint ta limite gratuite.");
                    return;
                }
            }
            const tokenData = await tokenRes.json();
            if (!tokenData.success) throw new Error("Token error");

            liveSocket = new WebSocket(`${tokenData.url}?key=${tokenData.key}`);
           playbackContext = new (
    window.AudioContext ||
    window.webkitAudioContext
)({
    sampleRate: 24000
});

await playbackContext.audioWorklet.addModule(
    '/js/pcm-player-processor.js'
);

workletNode = new AudioWorkletNode(
    playbackContext,
    'pcm-player-processor'
);

workletNode.connect(
    playbackContext.destination
);

            liveSocket.onopen = async () => {
                if (playbackContext.state === 'suspended') await playbackContext.resume();
                liveSocket.send(JSON.stringify({
                    setup: {
                        model: "models/gemini-3.1-flash-live-preview",
                        generation_config: { response_modalities: ["AUDIO"] },
                        speech_config: {
                            voice_config: {
                                prebuilt_voice_config: {
                                    voice_name: "Aoede"
                                }
                            }
                        },
                        
                        system_instruction: { 
                            parts: [{ 
                                text: `You are Amina, a warm AI tutor. Course: ${window.CURRENT_COURSE_TYPE || 'general'}. Speak naturally. Avoid robotic pauses. Mix French + Moroccan Darija. Keep voice smooth.` 
                            }] 
                        }
                    }
                }));
                document.getElementById('callStatusText').innerText = "● LIVE";
                document.getElementById('callStatusText').style.color = "#22c55e";
                setTimeout(startStreamingPCMAudio, 700);
            };

          liveSocket.onmessage = async (event) => {

    try {

        // ✅ RAW BLOB AUDIO
        if (event.data instanceof Blob) {

            console.log(
                "BLOB AUDIO RECEIVED"
            );

            playRawPCM(
                await event.data.arrayBuffer()
            );
        }

        else {

            const data =
                JSON.parse(event.data);

            console.log(
                "GEMINI DATA:",
                data
            );

            // ✅ MODEL AUDIO
            if (
                data.serverContent?.modelTurn?.parts
            ) {

                for (
                    const part of
                    data.serverContent.modelTurn.parts
                ) {

                    // AUDIO
                if (part.text) {

    document.getElementById(
        'liveCaption'
    ).innerText = part.text;

    // ✅ PLAY CLEAN TTS
    const ttsRes = await fetch(
        '/api/ai/speak',
        {
            method: 'POST',
            headers: {
                'Content-Type':
                    'application/json'
            },
            body: JSON.stringify({
                text: part.text,
                courseType:
                    window.CURRENT_COURSE_TYPE
            })
        }
    );

    const ttsData =
        await ttsRes.json();

    if (ttsData.audioContent) {

        const audio = new Audio(
            'data:audio/mp3;base64,' +
            ttsData.audioContent
        );

        audio.play();

        simulateAminaSpeaking();
    }
}

                    // TEXT
                    if (part.text) {

                        console.log(
                            "TEXT:",
                            part.text
                        );

                        document.getElementById(
                            'liveCaption'
                        ).innerText =
                            part.text;
                    }
                }
            }

            // ✅ TRANSCRIPTION
            if (
                data.serverContent
                    ?.outputTranscription?.text
            ) {

                document.getElementById(
                    'liveCaption'
                ).innerText =
                    data.serverContent
                        .outputTranscription.text;
            }
        }

    } catch (e) {

        console.log(
            "ONMESSAGE ERROR:",
            e
        );
    }

            };
        } catch (error) {
            console.error("Call Error:", error);
            closeLiveCallScreen();
        }
    }

    function startStreamingPCMAudio() {
        if (!audioStream || !liveSocket) return;
        micAudioContext = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
        const source = micAudioContext.createMediaStreamSource(audioStream);
        audioProcessor = micAudioContext.createScriptProcessor(16384, 1, 1);
        source.connect(audioProcessor);
        audioProcessor.connect(micAudioContext.destination);
        audioProcessor.onaudioprocess = (e) => {
            if (liveSocket.readyState === WebSocket.OPEN && !isMuted) {
                const inputData = e.inputBuffer.getChannelData(0);
                const pcm16 = new Int16Array(inputData.length);
                for (let i = 0; i < inputData.length; i++) {
                    let s = Math.max(-1, Math.min(1, inputData[i]));
                    pcm16[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
                }
                const base64Audio = window.btoa(String.fromCharCode(...new Uint8Array(pcm16.buffer)));
                liveSocket.send(JSON.stringify({ realtimeInput: { audio: { data: base64Audio, mimeType: "audio/pcm;rate=16000" } } }));
            }
        };
    }

   let audioQueue = [];
let isPlayingAudio = false;

// ✅ SMOOTH AUDIO PLAYER
async function playRawPCM(arrayBuffer) {

    if (!playbackContext || !isCallActive) return;

    try {

        if (playbackContext.state === 'suspended') {
            await playbackContext.resume();
        }

        const evenBuffer =
            arrayBuffer.byteLength % 2 === 0
                ? arrayBuffer
                : arrayBuffer.slice(
                    0,
                    arrayBuffer.byteLength - 1
                );

        const int16 =
            new Int16Array(evenBuffer);

        if (int16.length === 0) return;

        const float32 =
            new Float32Array(int16.length);

        for (let i = 0; i < int16.length; i++) {

            float32[i] =
                int16[i] / 32768;
        }

        // ✅ SEND TO AUDIO WORKLET
       workletNode.port.postMessage(
    Array.from(float32)
);

    } catch (e) {

        console.log(
            "AudioWorklet Error:",
            e
        );
    }
}
// ✅ PROCESS AUDIO ONE BY ONE
async function processAudioQueue() {

    if (audioQueue.length === 0) {

        isPlayingAudio = false;
        return;
    }

    isPlayingAudio = true;

    const buffer = audioQueue.shift();

    const source =
        playbackContext.createBufferSource();

    source.buffer = buffer;

    // Smooth gain
    const gainNode =
        playbackContext.createGain();

    gainNode.gain.value = 0.95;

    source.connect(gainNode);

    gainNode.connect(
        playbackContext.destination
    );

    simulateAminaSpeaking();

    source.start(0);

    source.onended = () => {
        processAudioQueue();
    };
}

// ✅ BASE64 HELPER
function base64ToArrayBuffer(base64) {

    const binary = window.atob(base64);

    const bytes =
        new Uint8Array(binary.length);

    for (let i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
    }

    return bytes.buffer;
}

// ✅ CLOSE CALL
function closeLiveCallScreen() {

    document.getElementById(
        'liveCallScreen'
    ).classList.remove('active');

    setTimeout(() => {

        document.getElementById(
            'liveCallScreen'
        ).style.display = 'none';

    }, 400);

    isCallActive = false;

    audioQueue = [];
    isPlayingAudio = false;

    if (audioProcessor) {
        audioProcessor.disconnect();
        audioProcessor = null;
    }

    if (micAudioContext) {
        micAudioContext.close();
        micAudioContext = null;
    }

   if (playbackContext) {
    playbackContext.close();
    playbackContext = null;
}

if (workletNode) {
    workletNode.disconnect();
    workletNode = null;
}
    if (audioStream) {
        audioStream
            .getTracks()
            .forEach(track => track.stop());
    }

    if (liveSocket) {
        liveSocket.close();
        liveSocket = null;
    }
}

// ✅ MUTE
function toggleCallMute() {

    isMuted = !isMuted;

    const btn =
        document.getElementById('callMicBtn');

    btn.classList.toggle(
        'muted',
        isMuted
    );

    btn.innerHTML =
        isMuted ? '🔇' : '🎙️';
}

// ✅ SPEAKING ANIMATION
function simulateAminaSpeaking() {

    if (!isCallActive) return;

    const screen =
        document.getElementById(
            'liveCallScreen'
        );

    screen.classList.add('speaking');

    setTimeout(() => {

        if (isCallActive) {
            screen.classList.remove(
                'speaking'
            );
        }

    }, 1000);
}
</script>